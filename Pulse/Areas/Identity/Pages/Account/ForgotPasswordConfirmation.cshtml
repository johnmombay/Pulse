@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
}

@section Styles {
<style>
.bp-auth { display:flex; justify-content:center; padding:2rem 1rem 4rem; }
.bp-auth-card { width:100%; max-width:440px; background:var(--surface-1); border:1px solid var(--surface-border); border-radius:.9rem; box-shadow:var(--shadow-card-hover); padding:2.25rem 2.25rem 2rem; }
.bp-auth-divider { border-top:1px solid var(--surface-border); margin-top:1.5rem; padding-top:1.25rem; text-align:center; font-size:.83rem; color:var(--sidebar-text-muted); }
.bp-auth-divider a { color:var(--brand); font-weight:500; text-decoration:none; }
.bp-auth-divider a:hover { text-decoration:underline; }
</style>
}

<div class="bp-auth">
    <div class="bp-auth-card">

        <partial name="_AuthLogo" />

        <div class="mb-4" style="width:2.75rem;height:2.75rem;background:#dcfce7;border-radius:.65rem;display:flex;align-items:center;justify-content:center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
        </div>

        <h1 style="font-size:1.45rem;font-weight:700;margin-bottom:.3rem;color:var(--page-text)">Check your inbox</h1>
        <p style="font-size:.875rem;color:var(--sidebar-text-muted);margin-bottom:1.75rem">
            If an account with that email exists, we&rsquo;ve sent a password reset link.<br />
            <span style="font-size:.8rem">Didn&rsquo;t receive it? Check your spam folder.</span>
        </p>

        <a asp-page="./Login" class="w-100 btn btn-primary d-block text-center"
           style="height:2.75rem;font-weight:600;border-radius:.55rem;font-size:.925rem;line-height:2.75rem;padding:0">
            Back to sign in
        </a>

        <div class="bp-auth-divider">
            <a asp-page="./ForgotPassword">&larr; Try a different email</a>
        </div>

    </div>
</div>
