@page
@model SignupTenantModel
@{
    ViewData["Title"] = "Create your workspace";
}

@section Styles {
<style>
.bp-auth { display:flex; justify-content:center; padding:2rem 1rem 4rem; }
.bp-auth-card { width:100%; max-width:480px; background:var(--surface-1); border:1px solid var(--surface-border); border-radius:.9rem; box-shadow:var(--shadow-card-hover); padding:2.25rem 2.25rem 2rem; }
.bp-auth-card .form-control { background:var(--surface-2); border-color:var(--surface-border); color:var(--page-text); font-size:.875rem; }
.bp-auth-card .form-control:focus { background:var(--surface-1); border-color:var(--brand); box-shadow:0 0 0 3px rgba(37,99,235,.12); color:var(--page-text); }
.bp-auth-card .form-floating > label { color:var(--sidebar-text-muted); font-size:.82rem; }
.bp-auth-divider { border-top:1px solid var(--surface-border); margin-top:1.5rem; padding-top:1.25rem; text-align:center; font-size:.83rem; color:var(--sidebar-text-muted); }
.bp-auth-divider a { color:var(--brand); font-weight:500; text-decoration:none; }
</style>
}

<div class="bp-auth">
    <div class="bp-auth-card">

        <partial name="_AuthLogo" />

        <h1 style="font-size:1.45rem;font-weight:700;margin-bottom:.3rem;color:var(--page-text)">Create your workspace</h1>
        <p style="font-size:.875rem;color:var(--sidebar-text-muted);margin-bottom:1.75rem">Set up your organisation and admin account.</p>

        <form id="signupTenantForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3"
                 role="alert" style="font-size:.82rem;border-radius:.55rem"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.TenantName" class="form-control" autocomplete="organization" aria-required="true" placeholder="Organisation name" />
                <label asp-for="Input.TenantName">Organisation name</label>
                <span asp-validation-for="Input.TenantName" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>
            <div class="row g-2 mb-0">
                <div class="col-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="First name" />
                        <label asp-for="Input.FirstName">First name</label>
                        <span asp-validation-for="Input.FirstName" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Last name" />
                        <label asp-for="Input.LastName">Last name</label>
                        <span asp-validation-for="Input.LastName" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
                    </div>
                </div>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.com" />
                <label asp-for="Input.Email">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>
            <button id="signupTenantSubmit" type="submit" class="w-100 btn btn-primary" style="height:2.75rem;font-weight:600;border-radius:.55rem;font-size:.925rem">Create workspace</button>
        </form>

        <div class="bp-auth-divider">
            Already have an account? <a asp-page="/Account/Login" asp-area="Identity">Sign in</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
