@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

@section Styles {
<style>
.bp-auth { display:flex; justify-content:center; padding:2rem 1rem 4rem; }
.bp-auth-card {
    width:100%; max-width:440px;
    background:var(--surface-1);
    border:1px solid var(--surface-border);
    border-radius:.9rem;
    box-shadow:var(--shadow-card-hover);
    padding:2.25rem 2.25rem 2rem;
}
.bp-auth-card .form-control {
    background:var(--surface-2);
    border-color:var(--surface-border);
    color:var(--page-text);
    font-size:.875rem;
}
.bp-auth-card .form-control:focus {
    background:var(--surface-1);
    border-color:var(--brand);
    box-shadow:0 0 0 3px rgba(37,99,235,.12);
    color:var(--page-text);
}
.bp-auth-card .form-floating > label { color:var(--sidebar-text-muted); font-size:.82rem; }
.bp-auth-divider { border-top:1px solid var(--surface-border); margin-top:1.5rem; padding-top:1.25rem; text-align:center; font-size:.83rem; color:var(--sidebar-text-muted); }
.bp-auth-divider a { color:var(--brand); font-weight:500; text-decoration:none; }
.bp-auth-divider a:hover { text-decoration:underline; }
.bp-auth-links a { font-size:.8rem; color:var(--sidebar-text-muted); }
.bp-auth-links a:hover { color:var(--brand); }
</style>
}

<div class="bp-auth">
    <div class="bp-auth-card">

        <partial name="_AuthLogo" />

        <h1 style="font-size:1.45rem;font-weight:700;margin-bottom:.3rem;color:var(--page-text)">Welcome back</h1>
        <p style="font-size:.875rem;color:var(--sidebar-text-muted);margin-bottom:1.75rem">Sign in to continue to your dashboard.</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3"
                 role="alert" style="font-size:.82rem;border-radius:.55rem"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username"
                       aria-required="true" placeholder="you@example.com" />
                <label asp-for="Input.Email">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                       aria-required="true" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check mb-0">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe"
                           style="font-size:.84rem">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword"
                   style="font-size:.84rem;color:var(--brand);text-decoration:none">Forgot password?</a>
            </div>

            <button id="login-submit" type="submit"
                    class="w-100 btn btn-primary"
                    style="height:2.75rem;font-weight:600;border-radius:.55rem;font-size:.925rem">
                Sign In
            </button>
        </form>

        <div class="bp-auth-divider">
            No account?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
        </div>
        <div class="bp-auth-links text-center mt-2">
            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

