@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Set new password";
}

@section Styles {
<style>
.bp-auth { display:flex; justify-content:center; padding:2rem 1rem 4rem; }
.bp-auth-card { width:100%; max-width:440px; background:var(--surface-1); border:1px solid var(--surface-border); border-radius:.9rem; box-shadow:var(--shadow-card-hover); padding:2.25rem 2.25rem 2rem; }
.bp-auth-card .form-control { background:var(--surface-2); border-color:var(--surface-border); color:var(--page-text); font-size:.875rem; }
.bp-auth-card .form-control:focus { background:var(--surface-1); border-color:var(--brand); box-shadow:0 0 0 3px rgba(37,99,235,.12); color:var(--page-text); }
.bp-auth-card .form-floating > label { color:var(--sidebar-text-muted); font-size:.82rem; }
.bp-auth-divider { border-top:1px solid var(--surface-border); margin-top:1.5rem; padding-top:1.25rem; text-align:center; font-size:.83rem; color:var(--sidebar-text-muted); }
.bp-auth-divider a { color:var(--brand); font-weight:500; text-decoration:none; }
.bp-auth-divider a:hover { text-decoration:underline; }
.pw-toggle { position:absolute; right:.85rem; top:50%; transform:translateY(-50%); background:none; border:none; padding:0; color:var(--sidebar-text-muted); cursor:pointer; z-index:5; }
.pw-toggle:hover { color:var(--brand); }
</style>
}

<div class="bp-auth">
    <div class="bp-auth-card">

        <partial name="_AuthLogo" />

        <div class="mb-4" style="width:2.75rem;height:2.75rem;background:var(--brand-50);border-radius:.65rem;display:flex;align-items:center;justify-content:center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>

        <h1 style="font-size:1.45rem;font-weight:700;margin-bottom:.3rem;color:var(--page-text)">Set new password</h1>
        <p style="font-size:.875rem;color:var(--sidebar-text-muted);margin-bottom:1.75rem">Choose a strong password for your account.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3"
                 role="alert" style="font-size:.82rem;border-radius:.55rem"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username"
                       aria-required="true" placeholder="you@example.com" />
                <label asp-for="Input.Email">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>

            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.Password" id="pwNew" class="form-control pe-5" autocomplete="new-password"
                       aria-required="true" placeholder="New password" />
                <label asp-for="Input.Password">New password</label>
                <button type="button" class="pw-toggle" onclick="togglePw('pwNew',this)" tabindex="-1" aria-label="Show password">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
                <span asp-validation-for="Input.Password" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>

            <div class="form-floating mb-4 position-relative">
                <input asp-for="Input.ConfirmPassword" id="pwConfirm" class="form-control pe-5" autocomplete="new-password"
                       aria-required="true" placeholder="Confirm password" />
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <button type="button" class="pw-toggle" onclick="togglePw('pwConfirm',this)" tabindex="-1" aria-label="Show password">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>

            <button type="submit" class="w-100 btn btn-primary"
                    style="height:2.75rem;font-weight:600;border-radius:.55rem;font-size:.925rem">
                Reset Password
            </button>
        </form>

        <div class="bp-auth-divider">
            <a asp-page="./Login">&larr; Back to sign in</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function togglePw(id, btn) {
        const inp = document.getElementById(id);
        const show = inp.type === 'password';
        inp.type = show ? 'text' : 'password';
        btn.innerHTML = show
            ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
            : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    }
    </script>
}
