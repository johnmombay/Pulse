@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

@section Styles {
<style>
.bp-auth { display:flex; justify-content:center; padding:2rem 1rem 4rem; }
.bp-auth-card { width:100%; max-width:440px; background:var(--surface-1); border:1px solid var(--surface-border); border-radius:.9rem; box-shadow:var(--shadow-card-hover); padding:2.25rem 2.25rem 2rem; }
.bp-auth-card .form-control { background:var(--surface-2); border-color:var(--surface-border); color:var(--page-text); font-size:.875rem; }
.bp-auth-card .form-control:focus { background:var(--surface-1); border-color:var(--brand); box-shadow:0 0 0 3px rgba(37,99,235,.12); color:var(--page-text); }
.bp-auth-card .form-floating > label { color:var(--sidebar-text-muted); font-size:.82rem; }
.bp-auth-divider { border-top:1px solid var(--surface-border); margin-top:1.5rem; padding-top:1.25rem; text-align:center; font-size:.83rem; color:var(--sidebar-text-muted); }
.bp-auth-divider a { color:var(--brand); font-weight:500; text-decoration:none; }
</style>
}

<div class="bp-auth">
    <div class="bp-auth-card">

        <partial name="_AuthLogo" />

        <div class="mb-4" style="width:2.75rem;height:2.75rem;background:var(--brand-50);border-radius:.65rem;display:flex;align-items:center;justify-content:center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>

        <h1 style="font-size:1.45rem;font-weight:700;margin-bottom:.3rem;color:var(--page-text)">Reset password</h1>
        <p style="font-size:.875rem;color:var(--sidebar-text-muted);margin-bottom:1.75rem">Enter your email and we will send you a reset link.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3"
                 role="alert" style="font-size:.82rem;border-radius:.55rem"></div>
            <div class="form-floating mb-4">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.com" />
                <label asp-for="Input.Email">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger d-block mt-1" style="font-size:.78rem"></span>
            </div>
            <button type="submit" class="w-100 btn btn-primary" style="height:2.75rem;font-weight:600;border-radius:.55rem;font-size:.925rem">Send Reset Link</button>
        </form>

        <div class="bp-auth-divider">
            <a asp-page="./Login">&larr; Back to sign in</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
