@inject Pulse.Services.LlmSettingsService _appSettings
@inject Pulse.Infrastructure.ITenantContext _tenantCtx
@{
    var _settings = await _appSettings.GetAsync(_tenantCtx.TenantId ?? Guid.Empty);
    var _logoFile = _settings.LogoFileName;
    var _logoVer  = _settings.LogoVersion;
    var _hasLogo  = !string.IsNullOrEmpty(_logoFile);
    var _appName  = _settings.AppName ?? "Pulse";
}

<div class="d-flex align-items-center gap-2 mb-4">
    @if (_hasLogo)
    {
        <img src="/images/app-logo.png?v=@_logoVer"
             alt="Logo"
             style="height:26px;width:auto;max-width:140px;object-fit:contain" />
    }
    else
    {
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2"  y="14" width="4"  height="8"  rx="1" fill="var(--brand)" opacity=".7"/>
            <rect x="8"  y="9"  width="4"  height="13" rx="1" fill="var(--brand)" opacity=".85"/>
            <rect x="14" y="4"  width="4"  height="18" rx="1" fill="var(--brand)"/>
            <rect x="20" y="11" width="2"  height="11" rx="1" fill="var(--brand)" opacity=".5"/>
        </svg>
        <span style="font-weight:700;font-size:1rem;color:var(--nav-brand)">@_appName</span>
    }
</div>
