@inject Pulse.Services.LlmSettingsService _appSettings
@inject Pulse.Infrastructure.ITenantContext _tenantCtx
@{
    var _settings = await _appSettings.GetAsync(_tenantCtx.TenantId ?? Guid.Empty);
    var _logoFile = _settings.LogoFileName;
    var _logoVer  = _settings.LogoVersion;
    var _hasLogo  = !string.IsNullOrEmpty(_logoFile);
    var _appName  = _settings.AppName ?? "Pulse";
    var _logoUrl  = _tenantCtx.TenantId is Guid _tid
        ? $"/images/tenants/{_tid:N}/app-logo.png"
        : "/images/app-logo.png";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @_appName</title>
    <!-- Prevent flash of wrong theme -->
    <script>
        (function () {
            const t = localStorage.getItem('bp-theme');
            if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pulse.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="app-shell">

    <!-- ═══════════════════════════════════ SIDEBAR ═══════════════════════════════════ -->
    <nav class="sidebar" id="appSidebar" aria-label="Main navigation">

        <!-- Logo -->
        <a class="sidebar-logo" asp-area="" asp-controller="Home" asp-action="Index">
            @if (_hasLogo)
            {
                <img src="@_logoUrl?v=@_logoVer"
                     alt="Logo"
                     style="height:24px;width:auto;max-width:120px;object-fit:contain" />
            }
            else
            {
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2"  y="14" width="4" height="8"  rx="1" fill="#2563eb" opacity=".55"/>
                    <rect x="8"  y="9"  width="4" height="13" rx="1" fill="#2563eb" opacity=".75"/>
                    <rect x="14" y="4"  width="4" height="18" rx="1" fill="#2563eb"/>
                    <rect x="20" y="11" width="2" height="11" rx="1" fill="#2563eb" opacity=".4"/>
                </svg>
                <text>@_appName</text>
            }
        </a>

        <!-- Navigation links -->
        <ul class="sidebar-nav">
            <li>
                <a class="sidebar-nav-item"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Dashboard
                </a>
            </li>
            <li>
                <a class="sidebar-nav-item"
                   asp-area="" asp-controller="Agent" asp-action="Chat">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                    </svg>
                    AI Agent
                </a>
            </li>
            <li>
                <a class="sidebar-nav-item" asp-page="/Scheduler">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8"  y1="2" x2="8"  y2="6"/>
                        <line x1="3"  y1="10" x2="21" y2="10"/>
                    </svg>                    Scheduler
                </a>
            </li>
            <li>
                <a class="sidebar-nav-item" asp-page="/Workflows">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>
                        <path d="M12 7v4M5 17l5-4M19 17l-5-4"/>
                    </svg>
                    Workflows
                </a>
            </li>
            <li>
                <a class="sidebar-nav-item" asp-page="/Usage">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 3v18h18"/>
                        <path d="M7 15l4-4 3 3 5-6"/>
                    </svg>
                    Usage
                </a>
            </li>
            @if (User.IsInRole("TenantAdmin") || User.IsInRole("SuperAdmin"))
            {
                <li><div class="nav-section-label">Admin</div></li>
                <li>
                    <a class="sidebar-nav-item" asp-page="/Admin/Users">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                        Users
                    </a>
                </li>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <li>
                        <a class="sidebar-nav-item" asp-page="/Admin/Tenants">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
                            </svg>
                            Tenants
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-nav-item" asp-page="/Admin/Plans">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                <line x1="1" y1="10" x2="23" y2="10"/>
                            </svg>
                            Plans
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-nav-item" asp-page="/Admin/Usage">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 21H3V3"/>
                                <path d="M7 14l3-3 4 4 5-7"/>
                                <circle cx="7" cy="14" r="1.5"/><circle cx="10" cy="11" r="1.5"/>
                                <circle cx="14" cy="15" r="1.5"/><circle cx="19" cy="8" r="1.5"/>
                            </svg>
                            Usage (All Tenants)
                        </a>
                    </li>
                }
                <li>
                    <a class="sidebar-nav-item" asp-page="/Settings">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
                        </svg>
                        Settings
                    </a>
                </li>
            }
        </ul>

        <!-- User footer -->
        <partial name="_LoginPartial" />

    </nav>

    <!-- Mobile backdrop -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- ═══════════════════════════════════ MAIN ═══════════════════════════════════ -->
    <div class="main-content">

        <!-- Top bar -->
        <header class="topbar">
            <!-- Mobile hamburger -->
            <button class="btn topbar-menu-btn d-none p-1" id="sidebarToggle"
                    style="color:var(--sidebar-text-muted);border:1px solid var(--surface-border);border-radius:.4rem;"
                    aria-label="Toggle navigation">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" aria-hidden="true">
                    <line x1="3" y1="6"  x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

            <span class="topbar-title">@(ViewData["Title"]?.ToString() ?? _appName)</span>

            <div class="topbar-actions">
                @await RenderSectionAsync("TopbarActions", required: false)
                <!-- Theme toggle -->
                <button class="theme-toggle-btn" id="themeToggleBtn" title="Toggle theme" aria-label="Toggle theme">
                    <svg id="themeIconSun" width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1"  x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22"   x2="5.64"  y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1"  y1="12" x2="3"  y2="12"/>
                        <line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22"  y1="19.78" x2="5.64"  y2="18.36"/>
                        <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
                    </svg>
                    <svg id="themeIconMoon" width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" style="display:none" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Page content -->
        <div class="@(ViewData["BodyClass"] ?? "page-body")">
            <main role="main">
                @RenderBody()
            </main>
        </div>

    </div><!-- /main-content -->

</div><!-- /app-shell -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
(function () {
    'use strict';

    // ── Active sidebar item ───────────────────────────────────────────
    const path = window.location.pathname.toLowerCase();
    document.querySelectorAll('.sidebar-nav-item').forEach(function (a) {
        const href = (a.getAttribute('href') || '').toLowerCase().replace(/\/$/, '');
        if (!href) return;
        const isHome = href === '' || href === '/';
        if (isHome) {
            if (path === '/' || path === '') a.classList.add('active');
        } else if (path === href || path.startsWith(href + '/')) {
            a.classList.add('active');
        }
    });

    // ── Mobile sidebar toggle ─────────────────────────────────────────
    const sidebar  = document.getElementById('appSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    const toggle   = document.getElementById('sidebarToggle');

    function openSidebar()  { sidebar.classList.add('sidebar-open');    backdrop.classList.add('active'); }
    function closeSidebar() { sidebar.classList.remove('sidebar-open'); backdrop.classList.remove('active'); }

    if (toggle)   toggle.addEventListener('click', openSidebar);
    if (backdrop) backdrop.addEventListener('click', closeSidebar);

    // ── Theme toggle ──────────────────────────────────────────────────
    const themeBtn  = document.getElementById('themeToggleBtn');
    const iconSun   = document.getElementById('themeIconSun');
    const iconMoon  = document.getElementById('themeIconMoon');

    function syncThemeIcon() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (iconSun)  iconSun.style.display  = isDark ? 'none' : '';
        if (iconMoon) iconMoon.style.display = isDark ? ''     : 'none';
    }
    syncThemeIcon();

    if (themeBtn) {
        themeBtn.addEventListener('click', function () {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (isDark) {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('bp-theme', 'light');
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('bp-theme', 'dark');
            }
            syncThemeIcon();
        });
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
