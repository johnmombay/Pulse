@using Microsoft.AspNetCore.Identity
@using Pulse.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser  = await UserManager.GetUserAsync(User);
    var displayName  = (currentUser?.FirstName + " " + currentUser?.LastName).Trim();
    if (string.IsNullOrEmpty(displayName)) displayName = User.Identity?.Name ?? "User";
    var initials = string.Concat(
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                   .Select(w => char.ToUpper(w[0]).ToString())
                   .Take(2));

    <div class="sidebar-footer">
        <div class="user-avatar">@initials</div>
        <div class="user-info">
            <div class="user-name" title="@displayName">@displayName</div>
            <div class="user-email" title="@currentUser?.Email">@currentUser?.Email</div>
        </div>
        <a asp-area="Identity" asp-page="/Account/Manage/Index"
           class="sidebar-icon-btn" title="Profile settings">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
        </a>
        <form asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
              style="margin:0;display:contents">
            <button type="submit" class="sidebar-icon-btn" title="Sign out">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </button>
        </form>
    </div>
}
else
{
    <div class="sidebar-footer">
        <a asp-area="Identity" asp-page="/Account/Login"
           class="btn btn-primary btn-sm w-100">Sign In</a>
    </div>
}
