@inject Pulse.Services.LlmSettingsService _appSettings
@{
    ViewData["Title"]      = "AI Agent";
    ViewData["BodyClass"]  = "container-fluid p-0";
    ViewData["MainClass"]  = "";
    var sessionId = ViewData["SessionId"]?.ToString() ?? Guid.NewGuid().ToString("N");
    var userId    = ViewData["UserId"]?.ToString()    ?? "";
    var _appName  = _appSettings.Get().AppName ?? "Pulse";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
}

<div id="sessionData" data-session-id="@sessionId" data-user-id="@userId" style="display:none"></div>
<div class="pane-overlay" id="paneOverlay"></div>

<div class="chat-app" id="chatApp">

    <!-- ═══ PANE 1: CONVERSATIONS ═══════════════════════════════════════ -->
    <aside class="conv-pane" id="convPane">
        <div class="conv-top">
            <button class="pane-close-btn" id="convCloseBtn" aria-label="Close sidebar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>
        <button id="newChatBtn" class="new-chat-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            New Chat
        </button>
        <div class="conv-section-label">Recent</div>
        <div class="conv-list" id="convList"></div>
    </aside>

    <!-- ═══ PANE 2: CHAT ════════════════════════════════════════════════ -->
    <main class="chat-pane" id="chatPane">

        <!-- Minimal header ─────────────────────────────────────────── -->
        <div class="chat-header">
            <div class="chat-header-left">
                <button class="hdr-btn" id="toggleConvBtn" title="Toggle sidebar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
                </button>
            </div>
            <div class="chat-header-center">
                <span class="agent-label">@_appName AI</span>
                <span id="statusBadge" class="status-badge idle"></span>
            </div>
            <div class="chat-header-right">
                <button class="hdr-btn" id="themeToggleBtn" title="Toggle dark / light mode" aria-label="Toggle theme">
                    <!-- icon set by JS -->
                    <svg id="themeIconMoon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg id="themeIconSun"  width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                </button>
                <button class="hdr-btn" id="clearBtn" title="Clear session">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                </button>
                <button class="hdr-btn" id="toggleFilesBtn" title="Generated files">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                </button>
            </div>
        </div>

        <!-- Messages ───────────────────────────────────────────────── -->
        <div id="chatMessages" class="chat-messages">
            <div class="msg assistant" id="welcomeMsg">
                <div class="msg-avatar ai-avatar">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2l1.796 5.527L19 9l-5.204 1.473L12 16l-1.796-5.527L5 9l5.204-1.473L12 2z" fill="currentColor" opacity=".9"/>
                        <path d="M19 16l.898 2.764L22 19.5l-2.102.736L19 23l-.898-2.764L16 19.5l2.102-.736L19 16z" fill="currentColor" opacity=".6"/>
                        <path d="M5 3l.6 1.843L7.5 5.5l-1.9.657L5 8l-.6-1.843L2.5 5.5l1.9-.657L5 3z" fill="currentColor" opacity=".5"/>
                    </svg>
                </div>
                <div class="msg-body">
                    <div class="msg-bubble">
                        <strong>Hello!</strong> I am your @_appName AI Agent.<br>What would you like to work on today?
                    </div>
                    <div class="msg-time">Now</div>
                </div>
            </div>
            <div id="typingIndicator" class="msg assistant typing-indicator" style="display:none">
                <div class="msg-avatar ai-avatar">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2l1.796 5.527L19 9l-5.204 1.473L12 16l-1.796-5.527L5 9l5.204-1.473L12 2z" fill="currentColor" opacity=".9"/>
                    </svg>
                </div>
                <div class="msg-body">
                    <div class="msg-bubble">
                        <span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input ──────────────────────────────────────────────────── -->
        <div class="chat-input-area">
            <div id="attachmentChips" class="attachment-chips" style="display:none"></div>
            <div class="input-pill">
                <textarea id="messageInput" rows="1" placeholder="Message the agent..." autocomplete="off"></textarea>
                <div class="input-pill-actions">
                    <button id="attachBtn" class="attach-btn" title="Attach file — PDF, DOCX, XLSX, CSV, TXT and more">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                    </button>
                    <button id="sendBtn" class="send-btn" title="Send">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <input type="file" id="fileInput" multiple
               accept=".txt,.md,.csv,.json,.xml,.html,.htm,.js,.ts,.jsx,.tsx,.py,.cs,.sql,.yaml,.yml,.log,.ini,.sh,.bash,.ps1,.bat,.r,.rb,.go,.rs,.swift,.kt,.java,.cpp,.c,.h,.css,.php,.env,.toml,.conf,.cfg,.pdf,.docx,.xlsx,.xls"
               style="display:none" />
    </main>

    <!-- ═══ PANE 3: FILES ═══════════════════════════════════════════════ -->
    <aside class="files-pane" id="filesPane">
        <div class="files-header" id="filesHeader">
            <span class="files-header-title">Generated Files</span>
            <div class="files-header-actions">
                <button class="files-collapse-btn" id="filesCollapseBtn" title="Collapse" aria-expanded="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="18 15 12 9 6 15"/></svg>
                </button>
                <button class="pane-close-btn" id="filesCloseBtn" aria-label="Close files panel">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
        </div>
        <div id="filesEmpty" class="files-empty">
            <svg class="files-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                <path d="M12 11v6M9 14l3-3 3 3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <p>No files yet.</p>
            <small>Code blocks produced by the agent appear here, ready to download or copy.</small>
        </div>
        <div id="filesList" class="files-list"></div>
    </aside>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked@latest/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@latest/dist/chart.umd.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
