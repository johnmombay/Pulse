@page
@model Pulse.Pages.Admin.TenantsModel
@{
    ViewData["Title"] = "Tenant Management";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible mb-4" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <p class="text-muted small mb-0">@Model.Tenants.Count tenant(s) total</p>
    </div>
</div>

<div class="bp-card overflow-hidden">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th class="ps-4" style="width:20%">Name</th>
                <th style="width:15%">Slug</th>
                <th style="width:7%">Users</th>
                <th style="width:10%">Created</th>
                <th style="width:16%">Plan</th>
                <th style="width:10%">Billing</th>
                <th style="width:9%">Status</th>
                <th class="text-center" style="width:9%">Web Search</th>
                <th class="text-end pe-4" style="width:13%">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Tenants.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-5">No tenants found.</td>
                </tr>
            }
            @foreach (var row in Model.Tenants)
            {
                <tr>
                    <td class="ps-4 fw-medium">@row.Name</td>
                    <td class="text-muted">@row.Slug</td>
                    <td>@row.UserCount</td>
                    <td class="text-muted">@row.CreatedUtc</td>
                    <td>
                        @if (row.PlanName is not null)
                        {
                            <span class="badge bg-primary bg-opacity-75">@row.PlanName</span>
                        }
                        else
                        {
                            <span class="text-muted small">No plan</span>
                        }
                    </td>
                    <td>
                        @if (row.BillingCycle is not null)
                        {
                            <span class="text-muted small">@row.BillingCycle</span>
                        }
                    </td>
                    <td>
                        @if (row.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-center">
                        <form method="post" asp-page-handler="ToggleWebSearch" asp-route-id="@row.Id">
                            <button class="btn btn-sm @(row.WebSearchEnabled ? "btn-success" : "btn-outline-secondary")"
                                    type="submit"
                                    title="@(row.WebSearchEnabled ? "Disable web search" : "Enable web search")">
                                🔍 @(row.WebSearchEnabled ? "On" : "Off")
                            </button>
                        </form>
                    </td>
                    <td class="text-end pe-4">
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-sm btn-outline-primary js-open-plan-modal"
                                    data-tenant-id="@row.Id"
                                    data-tenant-name="@row.Name"
                                    data-current-plan-id="@(row.CurrentPlanId?.ToString() ?? "")"
                                    data-current-cycle="@(row.BillingCycle ?? "Monthly")"
                                    title="@(row.PlanName is not null ? "Change plan" : "Assign plan")">
                                @(row.PlanName is not null ? "Change Plan" : "Assign Plan")
                            </button>
                            @if (row.PlanName is not null)
                            {
                                <form method="post" asp-page-handler="CancelSubscription" asp-route-tenantId="@row.Id"
                                      onsubmit="return confirm('Cancel subscription for @row.Name?')">
                                    <button class="btn btn-sm btn-outline-warning" type="submit" title="Cancel subscription">
                                        Cancel Plan
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@row.Id">
                                <button class="btn btn-sm btn-outline-secondary" type="submit"
                                        title="@(row.IsActive ? "Deactivate tenant" : "Activate tenant")">
                                    @(row.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ════════════════════════ CHANGE PLAN MODAL ════════════════════════ -->
<div class="modal fade" id="assignPlanModal" tabindex="-1" aria-labelledby="assignPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="AssignPlan">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="AssignPlan.TenantId" id="assignTenantId" />
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-0" id="assignPlanModalLabel">Change Plan</h5>
                        <small id="assignTenantName" class="text-muted"></small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <!-- Current plan banner -->
                    <div id="currentPlanBanner" class="alert alert-secondary py-2 px-3 mb-3 d-none" style="font-size:.85rem;border-radius:.5rem">
                        Current plan: <strong id="currentPlanLabel"></strong>
                    </div>

                    <!-- Billing cycle toggle -->
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="text-muted small">Billing cycle:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="cycleToggle" id="cycleMonthly" value="Monthly" autocomplete="off" checked>
                            <label class="btn btn-outline-primary" for="cycleMonthly">Monthly</label>
                            <input type="radio" class="btn-check" name="cycleToggle" id="cycleAnnual" value="Annual" autocomplete="off">
                            <label class="btn btn-outline-primary" for="cycleAnnual">Annual</label>
                        </div>
                    </div>

                    <!-- Hidden fields posted to server -->
                    <input type="hidden" asp-for="AssignPlan.SubscriptionPlanId" id="selectedPlanIdField" />
                    <input type="hidden" asp-for="AssignPlan.BillingCycle"       id="selectedCycleField"  value="Monthly" />

                    <!-- Plan cards -->
                    <div id="planCards" class="row g-2">
                        @foreach (var plan in Model.PlanOptionsList)
                        {
                            <div class="col-md-4">
                                <div class="plan-pick-card h-100 p-3"
                                     data-plan-id="@plan.Id"
                                     data-plan-name="@plan.Name"
                                     data-monthly="@plan.MonthlyPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                     data-annual="@plan.AnnualPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                     style="border:2px solid var(--surface-border);border-radius:.7rem;cursor:pointer;transition:border-color .15s,box-shadow .15s">
                                    <div class="fw-semibold mb-1" style="color:var(--page-text)">@plan.Name</div>
                                    <div class="plan-price fs-5 fw-bold" style="color:var(--brand)">
                                        @(plan.MonthlyPrice == 0 ? "Free" : $"${plan.MonthlyPrice:0.00}")
                                    </div>
                                    <div class="plan-period text-muted" style="font-size:.78rem">/ month</div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!Model.PlanOptionsList.Any())
                    {
                        <div class="alert alert-warning mt-2" style="font-size:.85rem">No active plans found. Create a plan first.</div>
                    }
                </div>
                <div class="modal-footer">
                    <span id="modalPriceSummary" class="text-muted small me-auto"></span>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="assignSubmitBtn" class="btn btn-primary" disabled>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
.plan-pick-card:hover { border-color: var(--brand) !important; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
.plan-pick-card.selected { border-color: var(--brand) !important; box-shadow: 0 0 0 3px rgba(37,99,235,.18); background: rgba(37,99,235,.04); }
</style>
}

@section Scripts {
    <script>
        const plans = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanOptionsList));

        let _currentPlanId  = null;
        let _currentCycle   = 'Monthly';
        let _selectedPlanId = null;

        function refreshCards(modal) {
            const cycle = modal.querySelector('#cycleMonthly').checked ? 'Monthly' : 'Annual';
            modal.querySelectorAll('.plan-pick-card').forEach(card => {
                const id      = parseInt(card.dataset.planId);
                const price   = cycle === 'Annual' ? parseFloat(card.dataset.annual) : parseFloat(card.dataset.monthly);
                const isFree  = price === 0;
                card.querySelector('.plan-price').textContent  = isFree ? 'Free' : `$${price.toFixed(2)}`;
                card.querySelector('.plan-period').textContent = cycle === 'Annual' ? '/ year' : '/ month';
                card.classList.toggle('selected', id === _selectedPlanId);
            });
        }

        function updateSubmitState(modal) {
            const btn = modal.querySelector('#assignSubmitBtn');
            const summary = modal.querySelector('#modalPriceSummary');
            if (!_selectedPlanId) {
                btn.disabled = true;
                summary.textContent = '';
                return;
            }
            const sameAsBefore = _selectedPlanId === _currentPlanId &&
                modal.querySelector('#selectedCycleField').value === _currentCycle;
            btn.disabled = sameAsBefore;
            btn.textContent = sameAsBefore ? 'No change' : 'Save Changes';

            const p     = plans.find(x => x.id === _selectedPlanId);
            const cycle = modal.querySelector('#selectedCycleField').value;
            if (p) {
                const price = cycle === 'Annual' ? p.annualPrice : p.monthlyPrice;
                summary.textContent = `${p.name} · ${cycle} · ${price === 0 ? 'Free' : `$${price.toFixed(2)}`}`;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('assignPlanModal');

            // ── Open modal from "Change Plan / Assign Plan" button ────────────
            document.querySelectorAll('.js-open-plan-modal').forEach(btn => {
                btn.addEventListener('click', () => {
                    const tenantId      = btn.dataset.tenantId;
                    const tenantName    = btn.dataset.tenantName;
                    const currentPlanId = btn.dataset.currentPlanId
                        ? parseInt(btn.dataset.currentPlanId)
                        : null;
                    const currentCycle  = btn.dataset.currentCycle || 'Monthly';

                    _currentPlanId  = currentPlanId;
                    _currentCycle   = currentCycle;
                    _selectedPlanId = currentPlanId;

                    modal.querySelector('#assignTenantId').value          = tenantId;
                    modal.querySelector('#assignTenantName').textContent   = tenantName;
                    modal.querySelector('#selectedPlanIdField').value      = currentPlanId ?? '';
                    modal.querySelector('#selectedCycleField').value       = currentCycle;

                    // Current plan banner
                    const banner = modal.querySelector('#currentPlanBanner');
                    if (currentPlanId) {
                        const p = plans.find(x => x.id === currentPlanId);
                        modal.querySelector('#currentPlanLabel').textContent =
                            p ? `${p.name} (${currentCycle})` : 'Unknown';
                        banner.classList.remove('d-none');
                    } else {
                        banner.classList.add('d-none');
                    }

                    // Billing cycle toggle
                    modal.querySelector('#cycleMonthly').checked = currentCycle !== 'Annual';
                    modal.querySelector('#cycleAnnual').checked  = currentCycle === 'Annual';

                    refreshCards(modal);
                    updateSubmitState(modal);
                    new bootstrap.Modal(modal).show();
                });
            });

            // ── Plan card click ───────────────────────────────────────────────
            modal.addEventListener('click', e => {
                const card = e.target.closest('.plan-pick-card');
                if (!card) return;
                _selectedPlanId = parseInt(card.dataset.planId);
                modal.querySelector('#selectedPlanIdField').value = _selectedPlanId;
                refreshCards(modal);
                updateSubmitState(modal);
            });

            // ── Billing cycle toggle ──────────────────────────────────────────
            modal.querySelectorAll('[name="cycleToggle"]').forEach(radio => {
                radio.addEventListener('change', () => {
                    modal.querySelector('#selectedCycleField').value = radio.value;
                    refreshCards(modal);
                    updateSubmitState(modal);
                });
            });
        });
    </script>
}
