@page
@model Pulse.Pages.Admin.PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusMessage.StartsWith("Cannot") ? "alert-warning" : "alert-success") alert-dismissible mb-4" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <p class="text-muted small mb-0">@Model.Plans.Count plan(s) total</p>
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2"
            data-bs-toggle="modal" data-bs-target="#createModal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New Plan
    </button>
</div>

<div class="bp-card overflow-hidden">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th class="ps-4" style="width:18%">Name</th>
                <th style="width:8%">Users</th>
                <th style="width:10%">Databases</th>
                <th style="width:8%">Agents</th>
                <th style="width:11%">Monthly Usage</th>
                <th style="width:9%">Monthly $</th>
                <th style="width:9%">Annual $</th>
                <th style="width:9%">Tenants</th>
                <th style="width:9%">Status</th>
                <th class="text-end pe-4" style="width:9%">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Plans.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-5">No subscription plans yet.</td>
                </tr>
            }
            @foreach (var plan in Model.Plans)
            {
                <tr>
                    <td class="ps-4">
                        <span class="fw-medium">@plan.Name</span>
                        @if (!string.IsNullOrEmpty(plan.Description))
                        {
                            <br /><small class="text-muted">@plan.Description</small>
                        }
                    </td>
                    <td>@plan.MaxUsersPerTenant.ToString("N0")</td>
                    <td>@plan.MaxDatabases.ToString("N0")</td>
                    <td>@plan.MaxAgents.ToString("N0")</td>
                    <td>@plan.MonthlyUsageLimitUnits.ToString("N0")</td>
                    <td>@plan.MonthlyPrice.ToString("C")</td>
                    <td>@plan.AnnualPrice.ToString("C")</td>
                    <td>@plan.TenantSubscriptions.Count</td>
                    <td>
                        @if (plan.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end pe-4">
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="openEditModal(@plan.Id,
                                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan.Name)),
                                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan.Description ?? "")),
                                        @plan.MaxUsersPerTenant,
                                        @plan.MaxDatabases,
                                        @plan.MaxAgents,
                                        @plan.MonthlyUsageLimitUnits,
                                        @plan.MonthlyPrice,
                                        @plan.AnnualPrice,
                                        @plan.OveragePricePerUser,
                                        @plan.OveragePricePerDatabase,
                                        @plan.OveragePricePerAgent,
                                        @plan.OveragePricePerUsageUnit,
                                        @plan.IsActive.ToString().ToLower())">
                                Edit
                            </button>
                            @if (plan.TenantSubscriptions.Count == 0)
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-id="@plan.Id"
                                      onsubmit="return confirm('Delete plan \'@plan.Name\'?')">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ════════════════════════ CREATE MODAL ════════════════════════ -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel">New Subscription Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @{
                        var createErrors = ModelState
                            .Where(k => k.Key.StartsWith("Create."))
                            .SelectMany(k => k.Value!.Errors)
                            .ToList();
                    }
                    @if (Model.ShowModal == "create" && createErrors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <ul class="mb-0">
                                @foreach (var e in createErrors)
                                {
                                    <li>@e.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }
                    <h6 class="fw-semibold mb-3">Plan Details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Create.Name" class="form-label"></label>
                            <input asp-for="Create.Name" class="form-control @(Model.ShowModal == "create" && ModelState["Create.Name"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                            <span asp-validation-for="Create.Name" class="invalid-feedback"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Create.Description" class="form-label"></label>
                            <input asp-for="Create.Description" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.MaxUsersPerTenant" class="form-label"></label>
                            <input asp-for="Create.MaxUsersPerTenant" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.MaxDatabases" class="form-label"></label>
                            <input asp-for="Create.MaxDatabases" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.MaxAgents" class="form-label"></label>
                            <input asp-for="Create.MaxAgents" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.MonthlyUsageLimitUnits" class="form-label"></label>
                            <input asp-for="Create.MonthlyUsageLimitUnits" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input asp-for="Create.IsActive" class="form-check-input" />
                                <label asp-for="Create.IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                    <h6 class="fw-semibold mb-3">Pricing</h6>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="Create.MonthlyPrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Create.MonthlyPrice" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.AnnualPrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Create.AnnualPrice" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-12"><div class="border-top pt-3"><small class="text-muted fw-medium">Overage Rates (charged per unit exceeding plan limits)</small></div></div>
                        <div class="col-md-3">
                            <label asp-for="Create.OveragePricePerUser" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Create.OveragePricePerUser" class="form-control" type="number" step="0.0001" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.OveragePricePerDatabase" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Create.OveragePricePerDatabase" class="form-control" type="number" step="0.0001" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.OveragePricePerAgent" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Create.OveragePricePerAgent" class="form-control" type="number" step="0.0001" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Create.OveragePricePerUsageUnit" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Create.OveragePricePerUsageUnit" class="form-control" type="number" step="0.000001" min="0" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ════════════════════════ EDIT MODAL ════════════════════════ -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" asp-for="Edit.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">Edit Subscription Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @{
                        var editErrors = ModelState
                            .Where(k => k.Key.StartsWith("Edit."))
                            .SelectMany(k => k.Value!.Errors)
                            .ToList();
                    }
                    @if (Model.ShowModal == "edit" && editErrors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <ul class="mb-0">
                                @foreach (var e in editErrors)
                                {
                                    <li>@e.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }
                    <h6 class="fw-semibold mb-3">Plan Details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Edit.Name" class="form-label"></label>
                            <input asp-for="Edit.Name" class="form-control @(Model.ShowModal == "edit" && ModelState["Edit.Name"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                            <span asp-validation-for="Edit.Name" class="invalid-feedback"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Edit.Description" class="form-label"></label>
                            <input asp-for="Edit.Description" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.MaxUsersPerTenant" class="form-label"></label>
                            <input asp-for="Edit.MaxUsersPerTenant" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.MaxDatabases" class="form-label"></label>
                            <input asp-for="Edit.MaxDatabases" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.MaxAgents" class="form-label"></label>
                            <input asp-for="Edit.MaxAgents" class="form-control" type="number" min="1" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.MonthlyUsageLimitUnits" class="form-label"></label>
                            <input asp-for="Edit.MonthlyUsageLimitUnits" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input asp-for="Edit.IsActive" class="form-check-input" />
                                <label asp-for="Edit.IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                    <h6 class="fw-semibold mb-3">Pricing</h6>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="Edit.MonthlyPrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Edit.MonthlyPrice" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.AnnualPrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Edit.AnnualPrice" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-12"><div class="border-top pt-3"><small class="text-muted fw-medium">Overage Rates (charged per unit exceeding plan limits)</small></div></div>
                        <div class="col-md-3">
                            <label asp-for="Edit.OveragePricePerUser" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Edit.OveragePricePerUser" class="form-control" type="number" step="0.0001" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.OveragePricePerDatabase" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Edit.OveragePricePerDatabase" class="form-control" type="number" step="0.0001" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.OveragePricePerAgent" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Edit.OveragePricePerAgent" class="form-control" type="number" step="0.0001" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Edit.OveragePricePerUsageUnit" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Edit.OveragePricePerUsageUnit" class="form-control" type="number" step="0.000001" min="0" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-open the correct modal when the server returns a validation failure
        (function () {
            const show = '@Model.ShowModal';
            if (show === 'create') new bootstrap.Modal(document.getElementById('createModal')).show();
            else if (show === 'edit') new bootstrap.Modal(document.getElementById('editModal')).show();
        })();

        function openEditModal(id, name, description, maxUsers, maxDbs, maxAgents, monthlyUsage,
            monthlyPrice, annualPrice, overUser, overDb, overAgent, overUsage, isActive) {
            const f = document.getElementById('editModal');
            f.querySelector('[name="Edit.Id"]').value                      = id;
            f.querySelector('[name="Edit.Name"]').value                    = name;
            f.querySelector('[name="Edit.Description"]').value             = description;
            f.querySelector('[name="Edit.MaxUsersPerTenant"]').value       = maxUsers;
            f.querySelector('[name="Edit.MaxDatabases"]').value            = maxDbs;
            f.querySelector('[name="Edit.MaxAgents"]').value               = maxAgents;
            f.querySelector('[name="Edit.MonthlyUsageLimitUnits"]').value  = monthlyUsage;
            f.querySelector('[name="Edit.MonthlyPrice"]').value            = monthlyPrice;
            f.querySelector('[name="Edit.AnnualPrice"]').value             = annualPrice;
            f.querySelector('[name="Edit.OveragePricePerUser"]').value     = overUser;
            f.querySelector('[name="Edit.OveragePricePerDatabase"]').value = overDb;
            f.querySelector('[name="Edit.OveragePricePerAgent"]').value    = overAgent;
            f.querySelector('[name="Edit.OveragePricePerUsageUnit"]').value = overUsage;
            f.querySelector('[name="Edit.IsActive"]').checked              = isActive;
            new bootstrap.Modal(f).show();
        }
    </script>
}
