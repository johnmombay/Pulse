<div id="tab-pane-skills" class="settings-tab-pane pt-4">
@* ═══════════════════════════════════════════════════════════════════════════
   SKILLS
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="settings-section-header">⚡ Skills</div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openAddSkillModal()">
            ➕ Add Skill
        </button>
    </div>

    @if (Model.Skills.Count == 0)
    {
        <div class="card-body text-center py-5 text-muted">
            <div style="font-size:2.5rem">⚡</div>
            <p class="mt-2 mb-1">No skills configured yet.</p>
            <p class="small">Skills inject custom instructions into every new agent session — like Claude's custom system prompts.</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="openAddSkillModal()">
                ➕ Add your first skill
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width:2.5rem"></th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sk in Model.Skills)
                    {
                        var descTrunc = sk.Description.Length > 60
                            ? sk.Description[..57] + "…"
                            : sk.Description;
                        <tr>
                            <td class="ps-3 text-center" style="font-size:1.3rem">@sk.Icon</td>
                            <td class="fw-semibold">@sk.Name</td>
                            <td class="text-muted small">@descTrunc</td>
                            <td>
                                @if (sk.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            data-skill-id="@sk.Id"
                                            data-skill-name="@sk.Name"
                                            data-skill-icon="@sk.Icon"
                                            data-skill-description="@sk.Description"
                                            data-skill-instructions="@sk.Instructions"
                                            data-skill-active="@sk.IsActive"
                                            onclick="openEditSkillModal(this)">
                                        ✏️
                                    </button>
                                    <form method="post" asp-page-handler="ToggleSkill" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@sk.Id" />
                                        <button type="submit"
                                                class="btn @(sk.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(sk.IsActive ? "Deactivate" : "Activate")">
                                            @(sk.IsActive ? "⏸" : "▶")
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger"
                                            onclick="confirmDeleteSkill('@sk.Id','@Html.Raw(sk.Name.Replace("'","\\\'"))')">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2 px-3">
            @Model.Skills.Count skill(s) — @Model.Skills.Count(s => s.IsActive) active
        </div>
    }
</div>

@* ── Hidden delete form for skills ────────────────────────────────────────── *@
<form id="skillDeleteForm" method="post" asp-page-handler="DeleteSkill">
    @Html.AntiForgeryToken()
    <input type="hidden" id="skillDeleteId" name="id" value="" />
</form>

@* ═══════════════════════════════════════════════════════════════════════════
   SKILL ADD / EDIT MODAL
═══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="skillModal" tabindex="-1" aria-labelledby="skillModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="skillModalLabel">Add Skill</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SaveSkill" id="skillForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <!-- Inline error -->
                    <div id="skillModalError" class="alert alert-danger alert-dismissible py-2 px-3 mb-3 d-none" role="alert">
                        <span id="skillModalErrorText"></span>
                        <button type="button" class="btn-close btn-sm"
                                onclick="document.getElementById('skillModalError').classList.add('d-none')"></button>
                    </div>

                    <input type="hidden" asp-for="Skill.Id" id="skillId" />

                    <div class="row g-3 mb-3">
                        <div class="col-auto" style="width:90px">
                            <label asp-for="Skill.Icon" class="form-label fw-semibold">Icon</label>
                            <input asp-for="Skill.Icon" id="skillIcon" class="form-control text-center"
                                   placeholder="⚡" style="font-size:1.4rem" maxlength="6" />
                        </div>
                        <div class="col">
                            <label asp-for="Skill.Name" class="form-label fw-semibold">
                                Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Skill.Name" id="skillName" class="form-control"
                                   placeholder="e.g. Business Analyst, Code Reviewer, Data Scientist" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Skill.Description" class="form-label fw-semibold">
                            Description <span class="text-muted fw-normal small">(optional)</span>
                        </label>
                        <input asp-for="Skill.Description" id="skillDescription" class="form-control"
                               placeholder="One-line summary of what this skill does" />
                    </div>

                    <div class="mb-3">
                        <!-- Label row: title + file badge + upload button -->
                        <div class="d-flex align-items-center justify-content-between mb-1 gap-2 flex-wrap">
                            <label asp-for="Skill.Instructions" class="form-label fw-semibold mb-0">
                                Instructions <span class="text-danger">*</span>
                            </label>
                            <div class="d-flex align-items-center gap-2">
                                <div id="skillFileBadge" class="skill-file-badge d-none" title="File loaded">
                                    📄 <span id="skillFileNameText"></span>
                                    <button type="button" class="btn-close btn-sm flex-shrink-0"
                                            style="font-size:.6rem"
                                            onclick="clearSkillFileBadge()"
                                            title="Dismiss"></button>
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        onclick="document.getElementById('skillFileInput').click()"
                                        title="Load instructions from .txt, .md or .prompt file">
                                    📁 Upload file
                                </button>
                            </div>
                        </div>

                        <!-- Hidden file input (accepts common text/prompt formats) -->
                        <input type="file" id="skillFileInput"
                               accept=".txt,.md,.markdown,.text,.prompt,.system,.json"
                               class="d-none" />

                        <!-- Drop zone wraps the textarea so overlay can be positioned over it -->
                        <div id="skillDropZone" class="position-relative">
                            <textarea asp-for="Skill.Instructions" id="skillInstructions"
                                      class="form-control" rows="7" spellcheck="true"
                                      placeholder="Type instructions here — or drag-and-drop a .txt / .md file onto this area…"></textarea>
                            <!-- Semi-transparent drop overlay, shown only while dragging -->
                            <div id="skillDropOverlay"
                                 class="position-absolute top-0 start-0 w-100 h-100 d-none
                                        d-flex align-items-center justify-content-center rounded border border-2 border-primary">
                                📄 Drop file to load instructions
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <div class="form-text mb-0">
                                Injected as a system message at session start. Markdown is supported.
                                Drag-and-drop a <code>.txt</code> or <code>.md</code> file to import.
                            </div>
                            <span id="skillCharCount" class="skill-char-count ms-3">0 chars</span>
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input asp-for="Skill.IsActive" id="skillIsActive" class="form-check-input"
                               type="checkbox" role="switch" checked />
                        <label asp-for="Skill.IsActive" class="form-check-label">Active</label>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="skillSaveBtn" class="btn btn-primary">💾 Save Skill</button>
                </div>
            </form>
        </div>
    </div>
</div>

</div><!-- /tab-pane-skills -->

<div id="tab-pane-agents" class="settings-tab-pane pt-4">
@* ═══════════════════════════════════════════════════════════════════════════
   AGENT DEFINITIONS
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="settings-section-header">🤖 Agent Definitions</div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openAddAgentModal()">
            ➕ Add Agent
        </button>
    </div>

    @if (Model.AgentDefinitions.Count == 0)
    {
        <div class="card-body text-center py-5 text-muted">
            <div style="font-size:2.5rem">🤖</div>
            <p class="mt-2 mb-1">No agents configured yet.</p>
            <p class="small">Define an orchestrator plus specialist agents to enable multi-agent routing. Without agents the system falls back to the legacy all-plugins mode.</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="openAddAgentModal()">
                ➕ Add your first agent
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width:2.5rem"></th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Model</th>
                        <th>Plugins</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ag in Model.AgentDefinitions)
                    {
                        var agJsonAttr = System.Text.Json.JsonSerializer.Serialize(ag);
                        <tr>
                            <td class="ps-3 text-center" style="font-size:1.3rem">@ag.Icon</td>
                            <td>
                                <div class="fw-semibold">@ag.Name</div>
                                @if (!string.IsNullOrWhiteSpace(ag.Description))
                                {
                                    <div class="text-muted small">@(ag.Description.Length > 60 ? ag.Description[..57] + "…" : ag.Description)</div>
                                }
                            </td>
                            <td>
                                @if (ag.IsOrchestrator)
                                {
                                    <span class="badge bg-primary">Orchestrator</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Specialist</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @if (!string.IsNullOrWhiteSpace(ag.ModelId))
                                {
                                    <code class="small">@ag.ModelId</code>
                                }
                                else
                                {
                                    <span class="text-muted">global</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @ag.AllowedPluginKeys.Count plugin(s)
                            </td>
                            <td>
                                @if (ag.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            data-agent="@agJsonAttr"
                                            onclick="openEditAgentModal(this)">
                                        ✏️
                                    </button>
                                    <form method="post" asp-page-handler="ToggleAgent" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@ag.Id" />
                                        <button type="submit"
                                                class="btn @(ag.IsEnabled ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(ag.IsEnabled ? "Disable" : "Enable")">
                                            @(ag.IsEnabled ? "⏸" : "▶")
                                        </button>
                                    </form>
                                    @if (!ag.IsOrchestrator)
                                    {
                                        <button type="button" class="btn btn-outline-danger"
                                                onclick="confirmDeleteAgent('@ag.Id','@Html.Raw(ag.Name.Replace("'","\\\'"))')">
                                            🗑
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2 px-3">
            @Model.AgentDefinitions.Count agent(s) —
            @Model.AgentDefinitions.Count(a => a.IsOrchestrator) orchestrator,
            @Model.AgentDefinitions.Count(a => !a.IsOrchestrator) specialist(s),
            @Model.AgentDefinitions.Count(a => a.IsEnabled) enabled
        </div>
    }
</div>

@* ── Hidden delete form ────────────────────────────────────────────────────── *@
<form id="agentDeleteForm" method="post" asp-page-handler="DeleteAgent">
    @Html.AntiForgeryToken()
    <input type="hidden" id="agentDeleteId" name="id" value="" />
</form>

@* ═══════════════════════════════════════════════════════════════════════════
   AGENT ADD / EDIT MODAL
═══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="agentModal" tabindex="-1" aria-labelledby="agentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="agentModalLabel">Add Agent</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SaveAgent" id="agentForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div id="agentModalError" class="alert alert-danger alert-dismissible py-2 px-3 mb-3 d-none" role="alert">
                        <span id="agentModalErrorText"></span>
                        <button type="button" class="btn-close btn-sm"
                                onclick="document.getElementById('agentModalError').classList.add('d-none')"></button>
                    </div>

                    <input type="hidden" asp-for="AgentDef.Id" id="agentId" />

                    @* ── Basic info ── *@
                    <div class="row g-3 mb-3">
                        <div class="col-auto" style="width:90px">
                            <label asp-for="AgentDef.Icon" class="form-label fw-semibold">Icon</label>
                            <input asp-for="AgentDef.Icon" id="agentIcon" class="form-control text-center"
                                   placeholder="🤖" style="font-size:1.4rem" maxlength="6" />
                        </div>
                        <div class="col">
                            <label asp-for="AgentDef.Name" class="form-label fw-semibold">
                                Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="AgentDef.Name" id="agentName" class="form-control"
                                   placeholder="e.g. Data Analyst, Document Writer, Researcher" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AgentDef.Description" class="form-label fw-semibold">
                            Description <span class="text-muted fw-normal small">(optional — shown to orchestrator for routing)</span>
                        </label>
                        <input asp-for="AgentDef.Description" id="agentDescription" class="form-control"
                               placeholder="One-line summary of what this agent specialises in" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AgentDef.SystemPrompt" class="form-label fw-semibold">
                            System Prompt <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="AgentDef.SystemPrompt" id="agentSystemPrompt"
                                  class="form-control" rows="5" spellcheck="true"
                                  placeholder="You are a specialist agent that…"></textarea>
                        <div class="form-text">Injected as the first system message for every turn this agent handles.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AgentDef.ModelId" class="form-label fw-semibold">
                                Model Override <span class="text-muted fw-normal small">(optional)</span>
                            </label>
                            <input asp-for="AgentDef.ModelId" id="agentModelId" class="form-control"
                                   list="agentGeminiModels" placeholder="Leave blank to use global model"
                                   spellcheck="false" autocomplete="off" />
                            <datalist id="agentGeminiModels">
                                <option value="gemini-2.0-flash">gemini-2.0-flash</option>
                                <option value="gemini-2.5-pro-preview-05-06">gemini-2.5-pro-preview</option>
                                <option value="gemini-1.5-pro">gemini-1.5-pro</option>
                                <option value="gemini-1.5-flash">gemini-1.5-flash</option>
                                <option value="gemini-2.0-flash-lite">gemini-2.0-flash-lite</option>
                            </datalist>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="AgentDef.SortOrder" class="form-label fw-semibold">Sort Order</label>
                            <input asp-for="AgentDef.SortOrder" id="agentSortOrder" type="number"
                                   class="form-control" min="0" max="999" />
                        </div>
                    </div>

                    <div class="d-flex gap-4 mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="AgentDef.IsOrchestrator" id="agentIsOrchestrator" class="form-check-input"
                                   type="checkbox" role="switch" />
                            <label asp-for="AgentDef.IsOrchestrator" class="form-check-label fw-semibold">
                                Orchestrator
                            </label>
                            <div class="form-text" style="font-size:.75rem">Only one orchestrator allowed per tenant.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="AgentDef.IsEnabled" id="agentIsEnabled" class="form-check-input"
                                   type="checkbox" role="switch" checked />
                            <label asp-for="AgentDef.IsEnabled" class="form-check-label fw-semibold">Enabled</label>
                        </div>
                    </div>

                    <hr class="my-3" />

                    @* ── Plugin Keys ── *@
                    <div class="mb-3">
                        <div class="fw-semibold mb-2">🔧 Allowed Plugins</div>
                        <div class="form-text mb-2">Select which plugins this agent can invoke.</div>
                        <div class="row g-2">
                            @{
                                var pluginDefs = new[]
                                {
                                    (Key: "Database",     Label: "🗄️ Database",      Hint: "Query SQL databases"),
                                    (Key: "Excel",        Label: "📊 Excel",          Hint: "Generate Excel reports"),
                                    (Key: "Pdf",          Label: "📄 PDF",            Hint: "Generate PDF documents"),
                                    (Key: "Word",         Label: "📝 Word",           Hint: "Generate Word documents"),
                                    (Key: "Chart",        Label: "📈 Chart",          Hint: "Render interactive charts"),
                                    (Key: "FlatFileData", Label: "📁 Flat Files",     Hint: "Query CSV / Excel data sources"),
                                    (Key: "Rag",          Label: "🗂️ RAG",            Hint: "Retrieve from knowledge base"),
                                    (Key: "Mcp",          Label: "🔌 MCP",            Hint: "Call MCP servers"),
                                    (Key: "Terminal",     Label: "🖥️ Terminal",       Hint: "Run shell commands"),
                                    (Key: "AgentMail",    Label: "✉️ AgentMail",      Hint: "Send / receive email"),
                                };
                            }
                            @foreach (var (key, label, hint) in pluginDefs)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="form-check" title="@hint">
                                        <input class="form-check-input agent-plugin-chk" type="checkbox"
                                               name="AgentDef.AllowedPluginKeys"
                                               value="@key"
                                               id="agentPlugin_@key" />
                                        <label class="form-check-label small" for="agentPlugin_@key">@label</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* ── Allowed Skills ── *@
                    @if (Model.Skills.Count > 0)
                    {
                        <hr class="my-3" />
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">⚡ Allowed Skills</div>
                            <div class="form-text mb-2">Skill instructions injected into this agent's session.</div>
                            <div class="row g-2">
                                @foreach (var sk in Model.Skills)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input agent-skill-chk" type="checkbox"
                                                   name="AgentDef.AllowedSkillIds"
                                                   value="@sk.Id"
                                                   id="agentSkill_@sk.Id" />
                                            <label class="form-check-label small" for="agentSkill_@sk.Id">
                                                @sk.Icon @sk.Name
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ── Allowed MCP Servers ── *@
                    @if (Model.McpServers.Count > 0)
                    {
                        <hr class="my-3" />
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">🔌 Allowed MCP Servers</div>
                            <div class="row g-2">
                                @foreach (var mcp in Model.McpServers)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input agent-mcp-chk" type="checkbox"
                                                   name="AgentDef.AllowedMcpServerIds"
                                                   value="@mcp.Id"
                                                   id="agentMcp_@mcp.Id" />
                                            <label class="form-check-label small" for="agentMcp_@mcp.Id">
                                                @mcp.Name
                                                <span class="badge bg-light text-secondary ms-1" style="font-size:.65rem">@mcp.TransportType</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ── Allowed Database Connections ── *@
                    @if (Model.DatabaseConnections.Any())
                    {
                        <hr class="my-3" />
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">🗄️ Allowed Database Connections</div>
                            <div class="row g-2">
                                @foreach (var (dbId, dbEntry) in Model.DatabaseConnections)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input agent-db-chk" type="checkbox"
                                                   name="AgentDef.AllowedDatabaseKeys"
                                                   value="@dbId"
                                                   id="agentDb_@dbId" />
                                            <label class="form-check-label small" for="agentDb_@dbId">
                                                @(string.IsNullOrWhiteSpace(dbEntry.Label) ? dbId : dbEntry.Label)
                                                <code class="small text-muted ms-1">@dbId</code>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ── Allowed Flat-File Sources ── *@
                    @if (Model.FlatFileSources.Count > 0)
                    {
                        <hr class="my-3" />
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">📁 Allowed Flat-File Sources</div>
                            <div class="row g-2">
                                @foreach (var ff in Model.FlatFileSources)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input agent-ff-chk" type="checkbox"
                                                   name="AgentDef.AllowedFlatFileIds"
                                                   value="@ff.Id"
                                                   id="agentFf_@ff.Id" />
                                            <label class="form-check-label small" for="agentFf_@ff.Id">
                                                @ff.Label
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ── Allowed RAG Documents ── *@
                    @if (Model.RagDocuments.Count > 0)
                    {
                        <hr class="my-3" />
                        <div class="mb-3">
                            <div class="fw-semibold mb-2">🗂️ Allowed RAG Documents</div>
                            <div class="row g-2">
                                @foreach (var rd in Model.RagDocuments)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input agent-rag-chk" type="checkbox"
                                                   name="AgentDef.AllowedRagDocumentIds"
                                                   value="@rd.Id"
                                                   id="agentRag_@rd.Id" />
                                            <label class="form-check-label small" for="agentRag_@rd.Id">
                                                @rd.Name
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="agentSaveBtn" class="btn btn-primary">💾 Save Agent</button>
                </div>
            </form>
        </div>
    </div>
</div>

</div><!-- /tab-pane-agents -->

<div id="tab-pane-rag" class="settings-tab-pane pt-4">
@* ═══════════════════════════════════════════════════════════════════════════
   RAG DOCUMENTS
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="settings-section-header">🗂️ RAG Documents</div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openAddRagModal()">
            ➕ Add Document
        </button>
    </div>

    @if (Model.RagDocuments.Count == 0)
    {
        <div class="card-body text-center py-5 text-muted">
            <div style="font-size:2.5rem">🗂️</div>
            <p class="mt-2 mb-1">No RAG documents yet.</p>
            <p class="small">Upload files or paste text to build a knowledge base the agent can search on every query.</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="openAddRagModal()">
                ➕ Add your first document
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Description</th>
                        <th>Source</th>
                        <th>Chunks</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.RagDocuments)
                    {
                        var desc = doc.Description.Length > 50
                            ? doc.Description[..47] + "…"
                            : doc.Description;
                        var srcLabel = doc.OriginalFileName is { Length: > 0 }
                            ? $"📄 {doc.OriginalFileName}"
                            : "📝 Text";
                        <tr>
                            <td class="ps-3 fw-semibold">@doc.Name</td>
                            <td class="text-muted small">@desc</td>
                            <td class="text-muted small" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                title="@doc.OriginalFileName">@srcLabel</td>
                            <td>
                                    @if (doc.ChunkCount > 0)
                                    {
                                        <span class="badge bg-secondary rag-chunk-badge"
                                              data-doc-id="@doc.Id"
                                              title="Loading embedding status…">
                                            @doc.ChunkCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark" title="No chunks stored yet">0</span>
                                    }
                                </td>
                            <td>
                                @if (doc.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            onclick="openEditRagModal('@doc.Id','@Html.Raw(doc.Name.Replace("'","\\\'"))','@Html.Raw(doc.Description.Replace("'","\\\'"))','@(doc.OriginalFileName ?? "")','@doc.ChunkCount','@doc.IsEnabled')">
                                        ✏️
                                    </button>
                                    <button type="button" class="btn btn-outline-info"
                                            id="reembed_@doc.Id"
                                            onclick="reembedRag('@doc.Id','@Html.Raw(doc.Name.Replace("'","\\\'"))')"
                                            title="Re-generate embeddings using the Gemini API">
                                        🔄
                                    </button>
                                    <form method="post" asp-page-handler="ToggleRag" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@doc.Id" />
                                        <button type="submit"
                                                class="btn @(doc.IsEnabled ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(doc.IsEnabled ? "Disable" : "Enable")">
                                            @(doc.IsEnabled ? "⏸" : "▶")
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger"
                                            onclick="confirmDeleteRag('@doc.Id','@Html.Raw(doc.Name.Replace("'","\\\'"))')">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2 px-3">
            @Model.RagDocuments.Count document(s) — @Model.RagDocuments.Count(d => d.IsEnabled) enabled —
            @Model.RagDocuments.Sum(d => d.ChunkCount) total chunks
        </div>
    }
</div>

@* ── Hidden delete form for RAG ───────────────────────────────────────────── *@
<form id="ragDeleteForm" method="post" asp-page-handler="DeleteRag">
    @Html.AntiForgeryToken()
    <input type="hidden" id="ragDeleteId" name="id" value="" />
</form>

@* ── Hidden re-embed form for RAG ─────────────────────────────────────────── *@
<form id="ragReembedForm" method="post" asp-page-handler="ReembedRag">
    @Html.AntiForgeryToken()
    <input type="hidden" id="ragReembedId" name="id" value="" />
</form>

@* ═══════════════════════════════════════════════════════════════════════════
   RAG ADD / EDIT MODAL
═══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="ragModal" tabindex="-1" aria-labelledby="ragModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ragModalLabel">Add RAG Document</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SaveRag" id="ragForm"
                  enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <!-- Inline error -->
                    <div id="ragModalError" class="alert alert-danger alert-dismissible py-2 px-3 mb-3 d-none">
                        <span id="ragModalErrorText"></span>
                        <button type="button" class="btn-close btn-sm"
                                onclick="document.getElementById('ragModalError').classList.add('d-none')"></button>
                    </div>

                    <input type="hidden" name="RagDoc.Id"         id="ragId" />
                    <input type="hidden" name="RagDoc.SourceType" id="ragSourceType" value="text" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                        <input name="RagDoc.Name" id="ragName" class="form-control"
                               placeholder="e.g. Company FAQ, Product Manual" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Description <span class="text-muted fw-normal small">(optional)</span>
                        </label>
                        <input name="RagDoc.Description" id="ragDescription" class="form-control"
                               placeholder="One-line summary of this knowledge source" />
                    </div>

                    <!-- Source type tabs -->
                    <ul class="nav nav-pills mb-3 gap-1" id="ragSourceTabs">
                        <li class="nav-item">
                            <button type="button" class="nav-link active px-3 py-1"
                                    id="ragTabText" onclick="setRagSource('text')">
                                📝 Paste text
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link px-3 py-1"
                                    id="ragTabFile" onclick="setRagSource('file')">
                                📁 Upload file
                            </button>
                        </li>
                    </ul>

                    <!-- ── Paste text panel ─────────────────────────────────── -->
                    <div id="ragPanelText">
                        <div class="d-flex align-items-center justify-content-between mb-1 gap-2 flex-wrap">
                            <label class="form-label fw-semibold mb-0">
                                Content <span class="text-danger">*</span>
                            </label>
                            <div class="d-flex align-items-center gap-2">
                                <div id="ragTextFileBadge" class="skill-file-badge d-none">
                                    📄 <span id="ragTextFileNameText"></span>
                                    <button type="button" class="btn-close btn-sm flex-shrink-0"
                                            style="font-size:.6rem"
                                            onclick="document.getElementById('ragTextFileBadge').classList.add('d-none')"></button>
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        onclick="document.getElementById('ragTextFileInput').click()"
                                        title="Load text from file">
                                    📁 Upload file
                                </button>
                            </div>
                        </div>
                        <input type="file" id="ragTextFileInput"
                               accept=".txt,.md,.markdown,.text,.csv,.prompt"
                               class="d-none" />
                        <div id="ragTextDropZone" class="position-relative">
                            <textarea name="RagDoc.Content" id="ragContent" class="form-control"
                                      rows="7" placeholder="Paste your knowledge-base text here, or drag-and-drop a .txt / .md file…"></textarea>
                            <div id="ragTextDropOverlay"
                                 class="position-absolute top-0 start-0 w-100 h-100 d-none
                                        d-flex align-items-center justify-content-center rounded border border-2 border-primary"
                                 style="background:rgba(13,110,253,.07);pointer-events:none;font-size:1.05rem;font-weight:500;color:#0d6efd;">
                                📄 Drop file to load content
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="form-text mb-0">
                                Drag-and-drop a <code>.txt</code> or <code>.md</code> file to auto-fill.
                            </span>
                            <span id="ragCharCount" class="skill-char-count ms-3">0 chars</span>
                        </div>
                    </div>

                    <!-- ── Upload file panel ────────────────────────────────── -->
                    <div id="ragPanelFile" style="display:none">
                        <!-- Existing source info (edit mode) -->
                        <div id="ragExistingInfo" class="alert alert-info py-2 small d-none mb-3">
                            Current: <strong id="ragExistingFile">-</strong>
                            (<strong id="ragExistingChunks">0</strong> chunks)
                            — upload a new file below to replace it.
                        </div>

                        <!-- Drop zone / file picker -->
                        <div id="ragFileDropZone"
                             class="border rounded p-4 text-center position-relative"
                             style="border-style:dashed!important;cursor:pointer;min-height:110px">
                            <div id="ragFileDropContent">
                                <div style="font-size:2rem">📁</div>
                                <div class="fw-semibold mt-1">Drop file here or <u>click to browse</u></div>
                                <div class="text-muted small mt-1">
                                    Accepts: <code>.txt</code> <code>.md</code> <code>.csv</code>
                                </div>
                            </div>
                            <div id="ragFileSelectedInfo" class="d-none">
                                <div class="text-success fw-semibold fs-6">
                                    📄 <span id="ragSelectedFileName"></span>
                                </div>
                                <div class="text-muted small mt-1">
                                    <span id="ragSelectedFileSize"></span> — ready to upload
                                </div>
                            </div>
                            <!-- Invisible file input overlaying the drop zone -->
                            <input type="file" id="ragFileInput" name="ragFileInput"
                                   accept=".txt,.md,.markdown,.csv,.text"
                                   class="position-absolute top-0 start-0 w-100 h-100"
                                   style="opacity:0;cursor:pointer" />
                        </div>
                        <div class="form-text mt-1">
                            The file is uploaded to the server, chunked, and embedded automatically.
                            Large files may take a few seconds.
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input type="checkbox" name="RagDoc.IsEnabled" id="ragEnabled"
                               class="form-check-input" role="switch" checked />
                        <label for="ragEnabled" class="form-check-label">Enabled</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="ragSaveBtn" class="btn btn-primary">
                        💾 Save Document
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

</div><!-- /tab-pane-rag -->

<div id="tab-pane-memory" class="settings-tab-pane pt-4">
@* ═══════════════════════════════════════════════════════════════════════════
   MEMORY
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="settings-section-header">🧠 Memory</div>
        <div class="d-flex gap-2">
            <a href="/Memory" class="btn btn-outline-secondary btn-sm" title="Full Memory page">
                ↗ Full Page
            </a>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-danger btn-sm dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false" title="Bulk delete memories">
                    🗑 Clear…
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><h6 class="dropdown-header small">Delete memories created in…</h6></li>
                    <li><button class="dropdown-item small" onclick="bulkDeleteMemory('yesterday')">📅 Yesterday</button></li>
                    <li><button class="dropdown-item small" onclick="bulkDeleteMemory('7d')">📅 Last 7 days</button></li>
                    <li><button class="dropdown-item small" onclick="bulkDeleteMemory('15d')">📅 Last 15 days</button></li>
                    <li><button class="dropdown-item small" onclick="bulkDeleteMemory('30d')">📅 Last 30 days</button></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><button class="dropdown-item small text-danger fw-semibold" onclick="bulkDeleteMemory('all')">⚠️ All memories</button></li>
                </ul>
            </div>
            <button type="button" class="btn btn-primary btn-sm" onclick="openAddMemoryModal()">
                ➕ Add Memory
            </button>
        </div>
    </div>

    @if (!Model.Memories.Any(m => m.IsActive))
    {
        <div class="card-body text-center py-5 text-muted">
            <div style="font-size:2.5rem">🧠</div>
            <p class="mt-2 mb-1">No memories yet.</p>
            <p class="small">The agent automatically extracts memorable facts after each conversation.<br />You can also add them manually.</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="openAddMemoryModal()">
                ➕ Add your first memory
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Memory</th>
                        <th style="width:120px">Category</th>
                        <th style="width:115px">Importance</th>
                        <th style="width:85px">Source</th>
                        <th style="width:110px">Added</th>
                        <th class="text-end pe-3" style="width:85px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mem in Model.Memories.Where(m => m.IsActive))
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="mem-content-cell">@mem.Content</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(mem.Category))
                                {
                                    <span class="badge bg-light text-secondary border small">@mem.Category</span>
                                }
                            </td>
                            <td>
                                <span class="mem-importance">
                                    @(new string('★', mem.Importance))@(new string('☆', 5 - mem.Importance))
                                </span>
                            </td>
                            <td>
                                <span class="@(mem.Source == "auto" ? "mem-src-auto" : "mem-src-manual")">
                                    @(mem.Source == "auto" ? "🤖 auto" : "✍️ manual")
                                </span>
                            </td>
                            <td class="text-muted small">@mem.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            data-mem-id="@mem.Id"
                                            data-mem-content="@mem.Content"
                                            data-mem-category="@(mem.Category ?? "")"
                                            data-mem-importance="@mem.Importance"
                                            onclick="openEditMemoryModal(this)"
                                            title="Edit">
                                        ✏️
                                    </button>
                                    <button type="button" class="btn btn-outline-danger"
                                            onclick="confirmDeleteMemory(@mem.Id)"
                                            title="Delete">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2 px-3 d-flex justify-content-between align-items-center">
            <span>
                @Model.Memories.Count(m => m.IsActive) active —
                @Model.Memories.Count(m => m.IsActive && m.Source == "auto") auto-extracted,
                @Model.Memories.Count(m => m.IsActive && m.Source == "manual") manual
            </span>
            <a href="/Memory" class="text-decoration-none small">↗ View all on Memory page</a>
        </div>
    }
</div>

@* ── Hidden delete form for Memory ────────────────────────────────────────── *@
<form id="memDeleteForm" method="post" asp-page-handler="DeleteMemory">
