</div><!-- /tab-pane-memory -->

@if (isSuperAdmin)
{
<div id="tab-pane-terminal" class="settings-tab-pane pt-4">
@* ═══════════════════════════════════════════════════════════════════════════
   TERMINAL (SHELL EXECUTION)
═══════════════════════════════════════════════════════════════════════════ *@
@{
    var terminalSuccess = TempData["TerminalSuccess"] as string;
    var ts = Model.Terminal;
}
@if (terminalSuccess != null)
{
    <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@terminalSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <div class="settings-section-header">🖥️ Terminal</div>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Allow the agent to execute shell commands (PowerShell, cmd, or bash) on the host machine
            and use the output in its responses. <strong>Only enable on trusted environments.</strong>
        </p>
        <form method="post" asp-page-handler="SaveTerminal">
            <div class="mb-3 d-flex align-items-center gap-3">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch"
                           asp-for="Terminal.IsEnabled" id="terminalEnabled">
                    <label class="form-check-label fw-semibold" for="terminalEnabled">
                        Enable terminal command execution
                    </label>
                </div>
                @if (ts.IsEnabled)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Disabled</span>
                }
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Terminal.DefaultShell" class="form-label fw-semibold">Default Shell</label>
                    <select asp-for="Terminal.DefaultShell" class="form-select">
                        <option value="powershell">PowerShell</option>
                        <option value="cmd">cmd.exe</option>
                        <option value="bash">Bash / WSL</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Terminal.TimeoutSeconds" class="form-label fw-semibold">Timeout (seconds)</label>
                    <input asp-for="Terminal.TimeoutSeconds" type="number"
                           class="form-control" min="5" max="300" />
                    <div class="form-text">5 – 300 seconds per command.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Terminal.MaxOutputLength" class="form-label fw-semibold">Max Output (chars)</label>
                    <input asp-for="Terminal.MaxOutputLength" type="number"
                           class="form-control" min="1000" max="100000" />
                    <div class="form-text">Output is truncated beyond this limit.</div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Terminal.WorkingDirectory" class="form-label fw-semibold">Working Directory</label>
                <input asp-for="Terminal.WorkingDirectory" type="text" class="form-control"
                       placeholder="Leave empty to use the application root directory"
                       style="font-family:monospace;font-size:.88rem" />
                <div class="form-text">Absolute path. The agent will run commands from this directory unless overridden per-command.</div>
            </div>

            <button type="submit" class="btn btn-primary btn-sm">💾 Save Terminal Settings</button>
        </form>
    </div>
</div>
</div><!-- /tab-pane-terminal -->
}

@* ═══════════════════════════════════════════════════════════════════════════
   AGENTMAIL (SuperAdmin only — global outbound email config)
═══════════════════════════════════════════════════════════════════════════ *@
@if (isSuperAdmin)
{
<div id="tab-pane-agentmail" class="settings-tab-pane pt-4">
@{
    var am = Model.AgentMail;
}
@if (agentMailSuccess != null)
{
    <div id="agentMailAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4" role="alert">
        ✅ <span>@agentMailSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <div class="settings-section-header">✉️ AgentMail</div>
        <p class="text-muted small mb-0">
            AgentMail lets the app send emails (e.g. password reset) from a dedicated inbox.
            <a href="https://agentmail.to" target="_blank" rel="noopener" class="ms-1">Get an API key ↗</a>
        </p>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="SaveAgentMail">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="AgentMail.IsEnabled" class="form-check-input" id="agentMailEnabled"
                           role="switch" style="width:2.6rem;height:1.3rem" />
                    <label class="form-check-label fw-semibold" for="agentMailEnabled">
                        Enable AgentMail
                    </label>
                </div>
                <div class="form-text">When disabled, outgoing emails (e.g. password reset) will not be sent.</div>
            </div>

            <hr class="my-3" />

            <div class="mb-3">
                <label asp-for="AgentMail.DefaultInbox" class="form-label fw-semibold">Default Inbox (From address)</label>
                <input asp-for="AgentMail.DefaultInbox" type="text" class="form-control"
                       placeholder="noreply@yourdomain.agentmail.to" spellcheck="false" autocomplete="off" />
                <div class="form-text">The inbox address emails are sent <em>from</em>. Must exist in your AgentMail account.</div>
            </div>

            <div class="mb-3">
                <label asp-for="AgentMail.ApiKey" class="form-label fw-semibold">API Key</label>
                <div class="input-group" style="max-width:560px">
                    <input asp-for="AgentMail.ApiKey" type="password" class="form-control"
                           placeholder="am_us_inbox_…" spellcheck="false" autocomplete="off"
                           id="agentMailApiKey" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="var i=document.getElementById('agentMailApiKey');i.type=i.type==='password'?'text':'password'">
                        👁
                    </button>
                </div>
                <div class="form-text">Found in your AgentMail dashboard under <em>API Keys</em>.</div>
            </div>

            <div class="mb-4">
                <label asp-for="AgentMail.BaseUrl" class="form-label fw-semibold">API Base URL</label>
                <input asp-for="AgentMail.BaseUrl" type="text" class="form-control"
                       placeholder="https://api.agentmail.to/v0" spellcheck="false" autocomplete="off" />
                <div class="form-text">Leave as default unless you are using a self-hosted AgentMail instance.</div>
            </div>

            <button type="submit" class="btn btn-primary btn-sm">💾 Save AgentMail Settings</button>
        </form>
    </div>
</div>
</div><!-- /tab-pane-agentmail -->
}

@* ═══════════════════════════════════════════════════════════════════════════
   SECURITY (SuperAdmin only — global authentication policy)
═══════════════════════════════════════════════════════════════════════════ *@
@if (isSuperAdmin)
{
<div id="tab-pane-security" class="settings-tab-pane pt-4">
@{
    var securitySuccess = TempData["SecuritySuccess"] as string;
    var sec = Model.Security;
}
@if (securitySuccess != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3" role="alert" id="securityAlert">
        ✅ <span>@securitySuccess</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <div class="settings-section-header">🔒 Login Security</div>
        <p class="text-muted small mb-0">Protect accounts from brute-force attacks by limiting failed sign-in attempts.</p>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="SaveSecurity">
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Security.MaxFailedLoginAttempts" class="form-label fw-semibold">
                        Max failed attempts before lockout
                    </label>
                    <input asp-for="Security.MaxFailedLoginAttempts" type="number" min="1" max="20"
                           class="form-control" style="max-width:120px" />
                    <span asp-validation-for="Security.MaxFailedLoginAttempts" class="text-danger small"></span>
                    <div class="form-text">Allowed range: 1 – 20. Default: 5.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Security.LoginLockoutHours" class="form-label fw-semibold">
                        Lockout duration (hours)
                    </label>
                    <input asp-for="Security.LoginLockoutHours" type="number" min="1" max="168"
                           class="form-control" style="max-width:120px" />
                    <span asp-validation-for="Security.LoginLockoutHours" class="text-danger small"></span>
                    <div class="form-text">Allowed range: 1 – 168 (1 week). Default: 1.</div>
                </div>
            </div>
            <div class="alert alert-info py-2 px-3 mt-4 mb-3" style="font-size:.83rem;border-radius:.55rem">
                ℹ️ After <strong>@sec.MaxFailedLoginAttempts</strong> failed attempt(s), the account is locked for
                <strong>@sec.LoginLockoutHours</strong> hour(s). Users can bypass the wait by resetting their password.
                Changes take effect immediately — no restart required.
            </div>
            <button type="submit" class="btn btn-primary btn-sm">💾 Save Security Settings</button>
        </form>
    </div>
</div>
</div><!-- /tab-pane-security -->
}

@section Scripts {
<script>
(function () {
    // ── Auto-dismiss alerts ───────────────────────────────────────────────────
    ['llmAlert', 'mcpAlert', 'skillAlert', 'ragAlert', 'memAlert', 'dbConnAlert', 'securityAlert', 'agentMailAlert', 'appNameAlert'].forEach(id => {
        const el = document.getElementById(id);
        if (el) setTimeout(() => bootstrap.Alert.getOrCreateInstance(el).close(), 4000);
    });

    // ── LLM: API key list (SuperAdmin only) ──────────────────────────────────
    const keysContainer = document.getElementById('keysContainer');
    const llmFormEl     = document.getElementById('llmForm');
    const addKeyBtnEl   = document.getElementById('addKeyBtn');
    if (keysContainer && llmFormEl && addKeyBtnEl) {

    function escHtml(s) {
        return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function reindexKeys() {
        keysContainer.querySelectorAll('.key-row').forEach((row, i) => {
            row.dataset.index = i;
            row.querySelector('input').name = `Input.ApiKeys[${i}]`;
            row.querySelector('.key-num').textContent = `#${i + 1}`;
        });
    }

    function buildKeyRow(idx, val) {
        const d = document.createElement('div');
        d.className = 'key-row'; d.dataset.index = idx;
        d.innerHTML = `<span class="key-num">#${idx+1}</span>
            <input type="password" name="Input.ApiKeys[${idx}]" value="${escHtml(val)}"
                   class="form-control" placeholder="AIza…" spellcheck="false" autocomplete="off"/>
            <button type="button" class="btn btn-outline-secondary btn-icon btn-toggle-vis" title="Show/hide">👁</button>
            <button type="button" class="btn btn-outline-danger btn-icon btn-remove-key" title="Remove">✕</button>`;
        return d;
    }

    keysContainer.addEventListener('click', e => {
        const tv = e.target.closest('.btn-toggle-vis');
        if (tv) {
            const inp = tv.closest('.key-row').querySelector('input');
            const hide = inp.type === 'password';
            inp.type = hide ? 'text' : 'password';
            tv.textContent = hide ? '🙈' : '👁';
            return;
        }
        const rm = e.target.closest('.btn-remove-key');
        if (rm) { rm.closest('.key-row').remove(); reindexKeys(); }
    });

    addKeyBtnEl.addEventListener('click', () => {
        const idx = keysContainer.querySelectorAll('.key-row').length;
        const row = buildKeyRow(idx, '');
        keysContainer.appendChild(row);
        row.querySelector('input').focus();
    });

    llmFormEl.addEventListener('submit', () => {
        document.getElementById('llmSaveTxt').textContent = 'Saving…';
        document.getElementById('llmSaveSpinner').classList.remove('d-none');
        document.getElementById('llmSaveBtn').disabled = true;
    });
    } // end LLM-only block

    // ── MCP modal helpers ─────────────────────────────────────────────────────
    window.updateTransportFields = function (type) {
        document.getElementById('httpFields').style.display  = type === 'http'  ? '' : 'none';
        document.getElementById('stdioFields').style.display = type === 'stdio' ? '' : 'none';
    };

    function clearMcpModal() {
        document.getElementById('mcpModalError').classList.add('d-none');
        document.getElementById('mcpId').value        = '';
        document.getElementById('mcpName').value      = '';
        document.getElementById('mcpTransport').value = 'http';
        document.getElementById('mcpUrl').value       = '';
        document.getElementById('mcpCommand').value   = '';
        document.getElementById('mcpArguments').value = '';
        document.getElementById('mcpEnabled').checked = true;
        updateTransportFields('http');
    }

    window.openAddMcpModal = function () {
        document.getElementById('mcpModalLabel').textContent = 'Add MCP Server';
        clearMcpModal();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mcpModal')).show();
    };

    window.openEditMcpModal = function (id, name, type, url, cmd, args, enabled) {
        document.getElementById('mcpModalLabel').textContent = 'Edit MCP Server';
        document.getElementById('mcpModalError').classList.add('d-none');
        document.getElementById('mcpId').value        = id;
        document.getElementById('mcpName').value      = name;
        document.getElementById('mcpTransport').value = type;
        document.getElementById('mcpUrl').value       = url;
        document.getElementById('mcpCommand').value   = cmd;
        document.getElementById('mcpArguments').value = args;
        document.getElementById('mcpEnabled').checked = (enabled === 'True');
        updateTransportFields(type);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mcpModal')).show();
    };

    window.confirmDeleteMcp = function (id, name) {
        if (!confirm(`Delete MCP server "${name}"?\n\nThis cannot be undone.`)) return;
        document.getElementById('mcpDeleteId').value = id;
        document.getElementById('mcpDeleteForm').submit();
    };

    // ── Skills modal ──────────────────────────────────────────────────────────

    // ── file upload helpers ───────────────────────────────────────────────────
    const skillInstructions = document.getElementById('skillInstructions');
    const skillFileInput    = document.getElementById('skillFileInput');
    const skillDropZone     = document.getElementById('skillDropZone');
    const skillDropOverlay  = document.getElementById('skillDropOverlay');
    const skillFileBadge    = document.getElementById('skillFileBadge');
    const skillFileNameText = document.getElementById('skillFileNameText');
    const skillCharCount    = document.getElementById('skillCharCount');

    const ALLOWED_EXTS = ['.txt', '.md', '.markdown', '.text', '.prompt', '.system', '.json'];

    function updateCharCount() {
        const n = skillInstructions.value.length;
        skillCharCount.textContent = n.toLocaleString() + ' chars';
        skillCharCount.style.color = n > 80000 ? '#dc3545' : '#6c757d';
    }

    function applyFile(file) {
        const ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
        if (!ALLOWED_EXTS.includes(ext)) {
            document.getElementById('skillModalErrorText').textContent =
                `Unsupported file type "${ext}". Allowed: ${ALLOWED_EXTS.join(', ')}`;
            document.getElementById('skillModalError').classList.remove('d-none');
            return;
        }
        const reader = new FileReader();
        reader.onload = evt => {
            skillInstructions.value = evt.target.result;
            updateCharCount();
            // Show badge with filename
            skillFileNameText.textContent = file.name;
            skillFileBadge.classList.remove('d-none');
            // Auto-fill Name from filename if the field is still empty
            const nameEl = document.getElementById('skillName');
            if (!nameEl.value.trim()) {
                const base = file.name
                    .replace(/\.[^.]+$/, '')        // remove extension
                    .replace(/[-_]/g, ' ')           // dashes/underscores → spaces
                    .trim();
                nameEl.value = base.charAt(0).toUpperCase() + base.slice(1);
            }
        };
        reader.onerror = () => {
            document.getElementById('skillModalErrorText').textContent = 'Could not read the file.';
            document.getElementById('skillModalError').classList.remove('d-none');
        };
        reader.readAsText(file, 'UTF-8');
        skillFileInput.value = ''; // reset so the same file can be re-selected
    }

    window.clearSkillFileBadge = () => skillFileBadge.classList.add('d-none');

    skillFileInput.addEventListener('change', e => {
        if (e.target.files[0]) applyFile(e.target.files[0]);
    });

    skillInstructions.addEventListener('input', updateCharCount);

    // ── drag-and-drop onto the textarea ───────────────────────────────────────
    let dragCounter = 0; // track nested dragenter/dragleave

    skillDropZone.addEventListener('dragenter', e => {
        e.preventDefault();
        dragCounter++;
        skillDropOverlay.classList.remove('d-none');
        skillInstructions.classList.add('drag-over');
    });

    skillDropZone.addEventListener('dragover', e => { e.preventDefault(); });

    skillDropZone.addEventListener('dragleave', () => {
        dragCounter--;
        if (dragCounter <= 0) {
            dragCounter = 0;
            skillDropOverlay.classList.add('d-none');
            skillInstructions.classList.remove('drag-over');
        }
    });

    skillDropZone.addEventListener('drop', e => {
        e.preventDefault();
        dragCounter = 0;
        skillDropOverlay.classList.add('d-none');
        skillInstructions.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file) applyFile(file);
    });

    // ── reset file state when modal opens ────────────────────────────────────
    function resetSkillFileState() {
        skillFileBadge.classList.add('d-none');
        skillFileInput.value = '';
        dragCounter = 0;
        skillDropOverlay.classList.add('d-none');
        skillInstructions.classList.remove('drag-over');
    }

    window.openAddSkillModal = function () {
        document.getElementById('skillModalLabel').textContent = 'Add Skill';
        document.getElementById('skillModalError').classList.add('d-none');
        document.getElementById('skillId').value           = '';
        document.getElementById('skillIcon').value         = '⚡';
        document.getElementById('skillName').value         = '';
        document.getElementById('skillDescription').value  = '';
        document.getElementById('skillInstructions').value = '';
        document.getElementById('skillIsActive').checked   = true;
        resetSkillFileState();
        updateCharCount();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('skillModal')).show();
        setTimeout(() => document.getElementById('skillName').focus(), 300);
    };

    window.openEditSkillModal = function (btn) {
        const d = btn.dataset;
        document.getElementById('skillModalLabel').textContent = 'Edit Skill';
        document.getElementById('skillModalError').classList.add('d-none');
        document.getElementById('skillId').value           = d.skillId;
        document.getElementById('skillIcon').value         = d.skillIcon;
        document.getElementById('skillName').value         = d.skillName;
        document.getElementById('skillDescription').value  = d.skillDescription;
        document.getElementById('skillInstructions').value = d.skillInstructions;
        document.getElementById('skillIsActive').checked   = (d.skillActive === 'True');
        resetSkillFileState();
        updateCharCount();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('skillModal')).show();
    };

    window.confirmDeleteSkill = function (id, name) {
        if (!confirm(`Delete skill "${name}"?\n\nThis cannot be undone.`)) return;
        document.getElementById('skillDeleteId').value = id;
        document.getElementById('skillDeleteForm').submit();
    };

    // ── Skill modal AJAX submit ────────────────────────────────────────────────
    document.getElementById('skillForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const form = this;
        const btn  = document.getElementById('skillSaveBtn');
        const orig = btn.innerHTML;

        document.getElementById('skillModalError').classList.add('d-none');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        btn.disabled = true;

        try {
            const resp = await fetch(form.action, { method: 'POST', body: new FormData(form) });
            let result;
            try { result = await resp.json(); }
            catch { result = { success: false, error: `Server error (HTTP ${resp.status}).` }; }

            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('skillModal'))?.hide();
                setTimeout(() => location.reload(), 300);
            } else {
                document.getElementById('skillModalErrorText').textContent = result.error ?? 'Unknown error.';
                document.getElementById('skillModalError').classList.remove('d-none');
            }
        } catch {
            document.getElementById('skillModalErrorText').textContent = 'Network error — please try again.';
            document.getElementById('skillModalError').classList.remove('d-none');
        } finally {
            btn.innerHTML = orig;
            btn.disabled = false;
        }
    });

    // ── MCP modal: AJAX submit ────────────────────────────────────────────────
    // Using fetch() instead of native form submit avoids all ModelState /
    // antiforgery edge-cases that occur when a partial form (modal only) posts
    // to a page that also has other [BindProperty] fields with [Required].
    document.getElementById('mcpForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const form    = this;
        const saveBtn = form.querySelector('[type="submit"]');
        const origHtml = saveBtn.innerHTML;

        // Clear previous error
        document.getElementById('mcpModalError').classList.add('d-none');

        // Show spinner
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        saveBtn.disabled = true;

        try {
            // FormData carries the __RequestVerificationToken hidden field automatically
            const resp = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            });

            let result;
            try { result = await resp.json(); }
            catch { result = { success: false, error: `Server error (HTTP ${resp.status}).` }; }

            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('mcpModal'))?.hide();
                // Brief pause so the modal close animation completes, then reload
                setTimeout(() => location.reload(), 300);
            } else {
                document.getElementById('mcpModalErrorText').textContent = result.error ?? 'Unknown error.';
                document.getElementById('mcpModalError').classList.remove('d-none');
            }
        } catch (err) {
            document.getElementById('mcpModalErrorText').textContent = 'Network error — please try again.';
            document.getElementById('mcpModalError').classList.remove('d-none');
        } finally {
            saveBtn.innerHTML = origHtml;
            saveBtn.disabled = false;
        }
    });

    // ══════════════════════════════════════════════════════════════════════════
    // RAG MODAL
    // ══════════════════════════════════════════════════════════════════════════

    // ── source-type tabs ──────────────────────────────────────────────────────
    window.setRagSource = function (type) {
        document.getElementById('ragSourceType').value = type;
        document.getElementById('ragPanelText').style.display = type === 'text' ? '' : 'none';
        document.getElementById('ragPanelFile').style.display = type === 'file' ? '' : 'none';
        document.getElementById('ragTabText').classList.toggle('active', type === 'text');
        document.getElementById('ragTabFile').classList.toggle('active', type === 'file');
    };

    // ── RAG text-mode: drag-and-drop file loading (client-side, like Skills) ──
    const ragContent       = document.getElementById('ragContent');
    const ragTextFileInput = document.getElementById('ragTextFileInput');
    const ragTextDropZone  = document.getElementById('ragTextDropZone');
    const ragTextOverlay   = document.getElementById('ragTextDropOverlay');
    const ragCharCount     = document.getElementById('ragCharCount');
    const RAG_ALLOWED      = ['.txt','.md','.markdown','.text','.csv','.prompt'];

    function updateRagCharCount() {
        ragCharCount.textContent = ragContent.value.length.toLocaleString() + ' chars';
    }

    function loadRagTextFile(file) {
        const ext = file.name.slice(file.name.lastIndexOf('.')).toLowerCase();
        if (!RAG_ALLOWED.includes(ext)) {
            document.getElementById('ragModalErrorText').textContent =
                `Unsupported type "${ext}". Use ${RAG_ALLOWED.join(', ')}`;
            document.getElementById('ragModalError').classList.remove('d-none');
            return;
        }
        const reader = new FileReader();
        reader.onload = e => {
            ragContent.value = e.target.result;
            updateRagCharCount();
            document.getElementById('ragTextFileNameText').textContent = file.name;
            document.getElementById('ragTextFileBadge').classList.remove('d-none');
            const nameEl = document.getElementById('ragName');
            if (!nameEl.value.trim()) {
                const base = file.name.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ').trim();
                nameEl.value = base.charAt(0).toUpperCase() + base.slice(1);
            }
        };
        reader.readAsText(file, 'UTF-8');
        ragTextFileInput.value = '';
    }

    ragTextFileInput.addEventListener('change', e => { if (e.target.files[0]) loadRagTextFile(e.target.files[0]); });
    ragContent.addEventListener('input', updateRagCharCount);

    let ragTextDragCounter = 0;
    ragTextDropZone.addEventListener('dragenter', e => {
        e.preventDefault(); ragTextDragCounter++;
        ragTextOverlay.classList.remove('d-none');
    });
    ragTextDropZone.addEventListener('dragover', e => e.preventDefault());
    ragTextDropZone.addEventListener('dragleave', () => {
        if (--ragTextDragCounter <= 0) { ragTextDragCounter = 0; ragTextOverlay.classList.add('d-none'); }
    });
    ragTextDropZone.addEventListener('drop', e => {
        e.preventDefault(); ragTextDragCounter = 0;
        ragTextOverlay.classList.add('d-none');
        if (e.dataTransfer.files[0]) loadRagTextFile(e.dataTransfer.files[0]);
    });

    // ── RAG file-mode: drop zone visual feedback ──────────────────────────────
    const ragFileInput      = document.getElementById('ragFileInput');
    const ragFileDropZone   = document.getElementById('ragFileDropZone');
    const ragFileDropContent= document.getElementById('ragFileDropContent');
    const ragFileSelectedInfo=document.getElementById('ragFileSelectedInfo');

    function showRagSelectedFile(file) {
        ragFileDropContent.classList.add('d-none');
        ragFileSelectedInfo.classList.remove('d-none');
        document.getElementById('ragSelectedFileName').textContent = file.name;
        document.getElementById('ragSelectedFileSize').textContent =
            file.size > 1024 * 1024
                ? (file.size / 1024 / 1024).toFixed(1) + ' MB'
                : (file.size / 1024).toFixed(0) + ' KB';
    }

    ragFileInput.addEventListener('change', e => { if (e.target.files[0]) showRagSelectedFile(e.target.files[0]); });

    let ragFileDragCounter = 0;
    ragFileDropZone.addEventListener('dragenter', e => {
        e.preventDefault(); ragFileDragCounter++;
        ragFileDropZone.classList.add('border-primary');
    });
    ragFileDropZone.addEventListener('dragover', e => e.preventDefault());
    ragFileDropZone.addEventListener('dragleave', () => {
        if (--ragFileDragCounter <= 0) { ragFileDragCounter = 0; ragFileDropZone.classList.remove('border-primary'); }
    });
    ragFileDropZone.addEventListener('drop', e => {
        e.preventDefault(); ragFileDragCounter = 0;
        ragFileDropZone.classList.remove('border-primary');
        const file = e.dataTransfer.files[0];
        if (file) {
            // Create a DataTransfer to assign to the input's files
            const dt = new DataTransfer(); dt.items.add(file);
            ragFileInput.files = dt.files;
            showRagSelectedFile(file);
        }
    });

    // ── modal open helpers ────────────────────────────────────────────────────
    function resetRagModal() {
        document.getElementById('ragModalError').classList.add('d-none');
        document.getElementById('ragId').value          = '';
        document.getElementById('ragName').value        = '';
        document.getElementById('ragDescription').value = '';
        ragContent.value = ''; updateRagCharCount();
        ragTextFileInput.value = '';
        document.getElementById('ragTextFileBadge').classList.add('d-none');
        // reset file-mode
        ragFileInput.value = '';
        ragFileDropContent.classList.remove('d-none');
        ragFileSelectedInfo.classList.add('d-none');
        ragFileDropZone.classList.remove('border-primary');
        document.getElementById('ragExistingInfo').classList.add('d-none');
        document.getElementById('ragEnabled').checked = true;
        setRagSource('text');
    }

    window.openAddRagModal = function () {
        resetRagModal();
        document.getElementById('ragModalLabel').textContent = 'Add RAG Document';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('ragModal')).show();
        setTimeout(() => document.getElementById('ragName').focus(), 300);
    };

    window.openEditRagModal = async function (id, name, description, existingFile, chunkCount, enabled) {
        resetRagModal();
        document.getElementById('ragModalLabel').textContent = 'Edit RAG Document';
        document.getElementById('ragId').value          = id;
        document.getElementById('ragName').value        = name;
        document.getElementById('ragDescription').value = description;
        document.getElementById('ragEnabled').checked   = (enabled === 'True');

        // Show existing file info in the upload panel
        if (existingFile) {
            document.getElementById('ragExistingFile').textContent   = existingFile;
            document.getElementById('ragExistingChunks').textContent = chunkCount;
            document.getElementById('ragExistingInfo').classList.remove('d-none');
        }

        // Always switch to paste-text tab and load the saved content into the textarea
        setRagSource('text');
        ragContent.value = '';
        ragContent.placeholder = 'Loading saved content…';
        ragContent.disabled = true;
        updateRagCharCount();

        bootstrap.Modal.getOrCreateInstance(document.getElementById('ragModal')).show();

        // Fetch saved content.txt from the server
        try {
            const resp = await fetch(`?handler=RagContent&id=${encodeURIComponent(id)}`);
            if (resp.ok) {
                const data = await resp.json();
                if (data.found) {
                    ragContent.value = data.content ?? '';
                } else {
                    ragContent.value = '';
                    ragContent.placeholder = 'No saved content found — paste new text or upload a file.';
                }
            }
        } catch {
            ragContent.placeholder = 'Could not load saved content.';
        } finally {
            ragContent.disabled = false;
            updateRagCharCount();
        }
    };

    window.confirmDeleteRag = function (id, name) {
        if (!confirm(`Delete RAG document "${name}"?\n\nThis also removes all stored embeddings and cannot be undone.`)) return;
        document.getElementById('ragDeleteId').value = id;
        document.getElementById('ragDeleteForm').submit();
    };

    // ── RAG form: AJAX submit ─────────────────────────────────────────────────
    document.getElementById('ragForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const form = this;
        const btn  = document.getElementById('ragSaveBtn');
        const orig = btn.innerHTML;

        document.getElementById('ragModalError').classList.add('d-none');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing…';
        btn.disabled = true;

        try {
            const resp = await fetch(form.action, { method: 'POST', body: new FormData(form) });
            let result;
            try { result = await resp.json(); }
            catch { result = { success: false, error: `Server error (HTTP ${resp.status}).` }; }

            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('ragModal'))?.hide();
                if (result.warning) {
                    // Show a page-level warning banner, then reload after a short pause
                    const banner = document.createElement('div');
                    banner.className = 'alert alert-warning alert-dismissible d-flex align-items-start gap-2 mb-4';
                    banner.innerHTML =
                        `⚠️ <span>${result.message}<br><small class="d-block mt-1">${result.warning}</small></span>` +
                        `<button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>`;
                    document.querySelector('.container, main, body > *').prepend(banner);
                    setTimeout(() => location.reload(), 5000);
                } else {
                    setTimeout(() => location.reload(), 300);
                }
            } else {
                document.getElementById('ragModalErrorText').textContent = result.error ?? 'Unknown error.';
                document.getElementById('ragModalError').classList.remove('d-none');
            }
        } catch {
            document.getElementById('ragModalErrorText').textContent = 'Network error — please try again.';
            document.getElementById('ragModalError').classList.remove('d-none');
        } finally {
            btn.innerHTML = orig;
            btn.disabled = false;
        }
    });

    // ── RAG: re-embed ─────────────────────────────────────────────────────────
    window.reembedRag = async function (id, name) {
        if (!confirm(`Re-generate embeddings for "${name}"?\n\nThis calls the Gemini embedding API for every chunk. Make sure your API key is working.`)) return;

        const btn  = document.getElementById('reembed_' + id);
        const orig = btn?.innerHTML ?? '🔄';
        if (btn) { btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>'; btn.disabled = true; }

        try {
            const fd = new FormData(document.getElementById('ragReembedForm'));
            document.getElementById('ragReembedId').value = id;
            // rebuild FormData after setting the id
            const fd2 = new FormData(document.getElementById('ragReembedForm'));
            const resp = await fetch('?handler=ReembedRag', { method: 'POST', body: fd2 });
            let result;
            try { result = await resp.json(); }
            catch { result = { success: false, error: `Server error (HTTP ${resp.status}).` }; }

            if (result.success) {
                alert(result.message);
                location.reload();
            } else {
                alert('Re-embedding failed:\n\n' + result.error);
            }
        } catch {
            alert('Network error during re-embedding.');
        } finally {
            if (btn) { btn.innerHTML = orig; btn.disabled = false; }
        }
    };

    // ── RAG: embedding health badges ──────────────────────────────────────────
    // For each row in the RAG table, fetch the chunk/embedding counts and update
    // the badge colour: green = fully embedded, amber = partial, red = none.
    document.querySelectorAll('.rag-chunk-badge[data-doc-id]').forEach(async badge => {
        const id = badge.dataset.docId;
        try {
            const resp = await fetch(`?handler=RagStatus&id=${encodeURIComponent(id)}`);
            if (!resp.ok) return;
            const { total, embedded } = await resp.json();
            if (total === 0) {
                badge.className = 'badge bg-warning text-dark rag-chunk-badge';
                badge.title = 'No chunks on disk — re-save the document.';
            } else if (embedded === 0) {
                badge.className = 'badge bg-danger rag-chunk-badge';
                badge.title = `${total} chunks stored but 0 embedded — embedding API may be unavailable. Keyword search is active as fallback.`;
                badge.textContent = `${total} ⚠️`;
            } else if (embedded < total) {
                badge.className = 'badge bg-warning text-dark rag-chunk-badge';
                badge.title = `${embedded} / ${total} chunks embedded — partial. Keyword search covers the rest.`;
                badge.textContent = `${embedded}/${total}`;
            } else {
                badge.className = 'badge bg-success rag-chunk-badge';
                badge.title = `${embedded} chunks fully embedded ✅`;
                badge.textContent = `${embedded} ✅`;
            }
        } catch { /* leave the default badge */ }
    });

    // ══════════════════════════════════════════════════════════════════════════
    // MEMORY MODAL
    // ══════════════════════════════════════════════════════════════════════════

    window.openAddMemoryModal = function () {
        document.getElementById('memoryModalLabel').textContent = 'Add Memory';
        document.getElementById('memModalError').classList.add('d-none');
        document.getElementById('memInputId').value          = '';
        document.getElementById('memInputContent').value     = '';
        document.getElementById('memInputCategory').value    = '';
        document.getElementById('memInputImportance').value  = '3';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('memoryModal')).show();
        setTimeout(() => document.getElementById('memInputContent').focus(), 300);
    };

    window.openEditMemoryModal = function (btn) {
        const d = btn.dataset;
        document.getElementById('memoryModalLabel').textContent = 'Edit Memory';
        document.getElementById('memModalError').classList.add('d-none');
        document.getElementById('memInputId').value         = d.memId;
        document.getElementById('memInputContent').value    = d.memContent;
        document.getElementById('memInputCategory').value   = d.memCategory;
        document.getElementById('memInputImportance').value = d.memImportance;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('memoryModal')).show();
    };

    window.confirmDeleteMemory = async function (id) {
        if (!confirm('Delete this memory?\n\nThe agent will no longer use it in future sessions.')) return;
        const form = document.getElementById('memDeleteForm');
        document.getElementById('memDeleteId').value = id;
        try {
            const resp = await fetch('?handler=DeleteMemory', { method: 'POST', body: new FormData(form) });
            const data = await resp.json();
            if (data.success) location.reload();
        } catch {
            alert('Failed to delete memory — please try again.');
        }
    };

    window.bulkDeleteMemory = async function (period) {
        const labels = {
            yesterday: 'yesterday',
            '7d':  'the last 7 days',
            '15d': 'the last 15 days',
            '30d': 'the last 30 days',
            all:   'ALL memories'
        };
        const label = labels[period] ?? period;
        if (!confirm(`Delete memories from ${label}?\n\nThis cannot be undone.`)) return;

        const form = document.getElementById('memDeleteForm');
        const fd   = new FormData(form);
        fd.append('period', period);

        try {
            const resp = await fetch('?handler=BulkDeleteMemory', { method: 'POST', body: fd });
            const data = await resp.json();
            if (data.success) {
                if (data.count > 0) { location.reload(); }
                else { alert('No matching memories found.'); }
            }
        } catch {
            alert('Failed to delete memories — please try again.');
        }
    };

    document.getElementById('memoryForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn  = document.getElementById('memSaveBtn');
        const orig = btn.innerHTML;
        document.getElementById('memModalError').classList.add('d-none');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        btn.disabled  = true;

        try {
            const resp   = await fetch(this.action, { method: 'POST', body: new FormData(this) });
            const result = await resp.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('memoryModal'))?.hide();
                setTimeout(() => location.reload(), 250);
            } else {
                document.getElementById('memModalErrorText').textContent = result.error ?? 'Unknown error.';
                document.getElementById('memModalError').classList.remove('d-none');
            }
        } catch {
            document.getElementById('memModalErrorText').textContent = 'Network error — please try again.';
            document.getElementById('memModalError').classList.remove('d-none');
        } finally {
            btn.innerHTML = orig;
            btn.disabled  = false;
        }
    });

    // ── Database Connections ──────────────────────────────────────────────────

    const DB_PROVIDER_HINTS = {
        SqlServer:  'e.g. Server=HOST;Database=DB;User Id=sa;Password=…;TrustServerCertificate=True;',
        AzureSQL:   'e.g. Server=host.database.windows.net;Database=DB;Authentication=Active Directory Default;Encrypt=True;',
        PostgreSQL: 'e.g. Host=HOST;Database=DB;Username=user;Password=…;SslMode=Require;',
        MySQL:      'e.g. Server=HOST;Database=DB;User=user;Password=…;SslMode=Required;',
        MariaDB:    'e.g. Server=HOST;Database=DB;User=user;Password=…;',
        Oracle:     'e.g. User Id=user;Password=\u2026;Data Source=HOST:1521/ORCL;  (use :param in queries, not @@param)',
    };

    window.updateDbConnProviderHint = function () {
        const provider = document.getElementById('dbConnProvider').value;
        document.getElementById('dbConnProviderHint').textContent = DB_PROVIDER_HINTS[provider] ?? '';
    };

    window.toggleDbConnStrVis = function (btn) {
        const inp  = document.getElementById('dbConnStr');
        const hide = inp.type === 'password';
        inp.type       = hide ? 'text' : 'password';
        btn.textContent = hide ? '🙈' : '👁';
    };

    function clearDbConnModal() {
        document.getElementById('dbConnModalError').classList.add('d-none');
        document.getElementById('dbConnModalSuccess').classList.add('d-none');
        document.getElementById('dbConnId').value        = '';
        document.getElementById('dbConnId').readOnly     = false;
        document.getElementById('dbConnLabel').value     = '';
        document.getElementById('dbConnProvider').value  = 'SqlServer';
        document.getElementById('dbConnStr').value       = '';
        document.getElementById('dbConnStr').type        = 'password';
        document.getElementById('dbConnMaxRows').value   = '500';
        document.getElementById('dbConnSchemas').value   = '';
        document.getElementById('dbConnReadOnly').checked = true;
        document.getElementById('dbConnEnabled').checked  = true;
        updateDbConnProviderHint();
    }

    window.openAddDbConnModal = function () {
        document.getElementById('dbConnModalLabel').textContent = 'Add Database Connection';
        clearDbConnModal();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('dbConnModal')).show();
    };

    window.openEditDbConnModal = function (id, label, provider, connStr, enabled, readOnly, maxRows, schemas) {
        document.getElementById('dbConnModalLabel').textContent = 'Edit Database Connection';
        document.getElementById('dbConnModalError').classList.add('d-none');
        document.getElementById('dbConnModalSuccess').classList.add('d-none');
        document.getElementById('dbConnId').value       = id;
        document.getElementById('dbConnId').readOnly    = true;   // can't rename existing key
        document.getElementById('dbConnLabel').value    = label;
        document.getElementById('dbConnProvider').value = provider;
        document.getElementById('dbConnStr').value      = connStr;
        document.getElementById('dbConnStr').type       = 'password';
        document.getElementById('dbConnMaxRows').value  = maxRows;
        document.getElementById('dbConnSchemas').value  = schemas;
        document.getElementById('dbConnReadOnly').checked = (readOnly === 'True');
        document.getElementById('dbConnEnabled').checked  = (enabled === 'True');
        updateDbConnProviderHint();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('dbConnModal')).show();
    };

    window.confirmDeleteDbConn = function (id) {
        if (!confirm(`Delete database connection "${id}"?\n\nThis cannot be undone.`)) return;
        document.getElementById('dbConnDeleteId').value = id;
        document.getElementById('dbConnDeleteForm').submit();
    };

    // AJAX save
    document.getElementById('dbConnForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn  = document.getElementById('dbConnSaveBtn');
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        btn.disabled  = true;

        document.getElementById('dbConnModalError').classList.add('d-none');
        document.getElementById('dbConnModalSuccess').classList.add('d-none');

        try {
            const fd  = new FormData(this);
            const res = await fetch('?handler=SaveDbConn', { method: 'POST', body: fd });
            const data = await res.json();

            if (data.success) {
                document.getElementById('dbConnModalSuccessText').textContent = data.message;
                document.getElementById('dbConnModalSuccess').classList.remove('d-none');
                setTimeout(() => window.location.reload(), 900);
            } else {
                document.getElementById('dbConnModalErrorText').textContent = data.error ?? 'Save failed.';
                document.getElementById('dbConnModalError').classList.remove('d-none');
            }
        } catch {
            document.getElementById('dbConnModalErrorText').textContent = 'Network error — please try again.';
            document.getElementById('dbConnModalError').classList.remove('d-none');
        } finally {
            btn.innerHTML = orig;
            btn.disabled  = false;
        }
    });

    // Test connection from the table row (existing saved connection)
    window.testDbConn = async function (id, btn) {
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        btn.disabled  = true;
        try {
            const res  = await fetch(`?handler=TestDbConn&id=${encodeURIComponent(id)}`);
            const data = await res.json();
            if (data.success) {
                btn.innerHTML = '✅';
                btn.title = data.message;
            } else {
                btn.innerHTML = '❌';
                btn.title = data.error;
            }
        } catch {
            btn.innerHTML = '❌';
            btn.title = 'Network error';
        } finally {
            btn.disabled = false;
            setTimeout(() => { btn.innerHTML = orig; btn.title = 'Test connection'; }, 4000);
        }
    };

    // Test connection from inside the modal (uses the live form values, not a saved ID)
    window.testDbConnFromModal = async function () {
        const btn  = document.getElementById('dbConnTestBtn');
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Testing…';
        btn.disabled  = true;
        document.getElementById('dbConnModalError').classList.add('d-none');
        document.getElementById('dbConnModalSuccess').classList.add('d-none');

        // Save temporarily so we can call the real test endpoint with a valid ID
        const fd  = new FormData(document.getElementById('dbConnForm'));
        try {
            const saveRes  = await fetch('?handler=SaveDbConn', { method: 'POST', body: fd });
            const saveData = await saveRes.json();
            if (!saveData.success) throw new Error(saveData.error ?? 'Save failed.');

            const testId  = document.getElementById('dbConnId').value.trim().toLowerCase().replace(/\s+/g, '-');
            const testRes  = await fetch(`?handler=TestDbConn&id=${encodeURIComponent(testId)}`);
            const testData = await testRes.json();

            if (testData.success) {
                document.getElementById('dbConnModalSuccessText').textContent = '✅ ' + testData.message;
                document.getElementById('dbConnModalSuccess').classList.remove('d-none');
            } else {
                throw new Error(testData.error);
            }
        } catch (err) {
            document.getElementById('dbConnModalErrorText').textContent = err.message;
            document.getElementById('dbConnModalError').classList.remove('d-none');
        } finally {
            btn.innerHTML = orig;
            btn.disabled  = false;
        }
    };

})();
</script>

<script>
// ── Flat-file data sources ─────────────────────────────────────────────────
(function () {

    function clearFfModal() {
        document.getElementById('ffId').value             = '';
        document.getElementById('ffLabel').value          = '';
        document.getElementById('ffFormat').value         = '0';
        document.getElementById('ffFile').value           = '';
        document.getElementById('ffCurrentFile').classList.add('d-none');
        document.getElementById('ffCurrentFileName').textContent = '';
        document.getElementById('ffFileRequired').style.display  = '';
        document.getElementById('ffDelimiter').value      = '';
        document.getElementById('ffSheet').value          = '';
        document.getElementById('ffEncoding').value       = 'UTF-8';
        document.getElementById('ffMaxRows').value        = '1000';
        document.getElementById('ffHeaders').checked      = true;
        document.getElementById('ffEnabled').checked      = true;
        document.getElementById('ffFixedWidthSpec').value = '';
        document.getElementById('ffModalError').classList.add('d-none');
        document.getElementById('ffModalSuccess').classList.add('d-none');
        onFfFormatChange();
    }

    window.onFfFormatChange = function () {
        const fmt = parseInt(document.getElementById('ffFormat').value);
        // 0=CSV, 1=Tab, 2=Excel, 3=JSON, 4=XML, 5=YAML, 6=FixedWidth
        const isDelimited  = fmt === 0 || fmt === 1;
        const isExcel      = fmt === 2;
        const isFixedWidth = fmt === 6;
        const hasHeadersFmt= fmt !== 3 && fmt !== 4 && fmt !== 5; // JSON/XML/YAML have no header row concept

        document.getElementById('ffDelimiterGroup').style.display  = isDelimited  ? '' : 'none';
        document.getElementById('ffSheetGroup').style.display       = isExcel      ? '' : 'none';
        document.getElementById('ffFixedWidthGroup').style.display  = isFixedWidth ? '' : 'none';
        document.getElementById('ffHeadersGroup').style.display     = hasHeadersFmt ? '' : 'none';
    };

    window.openAddFlatFileModal = function () {
        clearFfModal();
        document.getElementById('ffModalLabel').textContent = 'Add Data Source';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('ffModal')).show();
        setTimeout(() => document.getElementById('ffLabel').focus(), 300);
    };

    window.openEditFlatFileModal = async function (id) {
        clearFfModal();
        document.getElementById('ffModalLabel').textContent = 'Edit Data Source';
        document.getElementById('ffSaveBtn').innerHTML =
            '<span class="spinner-border spinner-border-sm me-1"></span>Loading…';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('ffModal')).show();

        try {
            const res = await fetch(`/api/flatfile/source/${encodeURIComponent(id)}`);
            if (!res.ok) throw new Error('Could not load source.');
            const s = await res.json();

            document.getElementById('ffId').value            = s.id;
            document.getElementById('ffLabel').value         = s.label;
            document.getElementById('ffFormat').value        = String(s.format);
            document.getElementById('ffDelimiter').value     = s.delimiter ?? '';
            document.getElementById('ffSheet').value         = s.sheetName ?? '';
            document.getElementById('ffEncoding').value      = s.encoding ?? 'UTF-8';
            document.getElementById('ffMaxRows').value       = s.maxRows ?? 1000;
            document.getElementById('ffHeaders').checked     = s.hasHeaders;
            document.getElementById('ffEnabled').checked     = s.isEnabled;
            document.getElementById('ffFixedWidthSpec').value= (s.fixedWidthColumns ?? []).join('\n');

            // Show existing filename — upload is optional when editing
            if (s.filePath) {
                const name = s.filePath.split(/[\\/]/).pop();
                document.getElementById('ffCurrentFileName').textContent = name;
                document.getElementById('ffCurrentFile').classList.remove('d-none');
                document.getElementById('ffFileRequired').style.display  = 'none';
            }

            onFfFormatChange();
        } catch (err) {
            document.getElementById('ffModalErrorText').textContent = err.message;
            document.getElementById('ffModalError').classList.remove('d-none');
        } finally {
            document.getElementById('ffSaveBtn').innerHTML = '💾 Save';
        }
    };

    window.confirmDeleteFlatFile = function (id, label) {
        if (!confirm(`Delete data source "${label}"?\n\nThis cannot be undone.`)) return;
        document.getElementById('ffDeleteId').value = id;
        document.getElementById('ffDeleteForm').submit();
    };

    window.previewFlatFile = async function (id, btn) {
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        btn.disabled  = true;

        document.getElementById('ffPreviewTitle').textContent = `Preview — ${id}`;
        const body = document.getElementById('ffPreviewBody');
        body.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('ffPreviewModal')).show();

        try {
            const res  = await fetch(`?handler=PreviewFlatFile&id=${encodeURIComponent(id)}`);
            const data = await res.json();
            if (!data.success) throw new Error(data.error ?? 'Preview failed.');

            if (!data.rows?.length) {
                body.innerHTML = '<p class="text-muted text-center py-4">No rows returned.</p>';
                return;
            }

            const cols   = data.columns;
            const thHtml = cols.map(c => `<th class="text-nowrap small">${escHtml(c)}</th>`).join('');
            const tbHtml = data.rows.map(row =>
                '<tr>' + cols.map(c => `<td class="small">${escHtml(row[c] ?? '')}</td>`).join('') + '</tr>'
            ).join('');

            body.innerHTML =
                `<p class="px-3 pt-2 mb-1 text-muted small">Showing ${data.rowCount} row(s) (first 10)</p>` +
                `<div class="table-responsive"><table class="table table-sm table-bordered mb-0">` +
                `<thead class="table-light"><tr>${thHtml}</tr></thead><tbody>${tbHtml}</tbody></table></div>`;
        } catch (err) {
            body.innerHTML = `<div class="alert alert-danger m-3 py-2">${escHtml(err.message)}</div>`;
        } finally {
            btn.innerHTML = orig;
            btn.disabled  = false;
        }
    };

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // AJAX save
    document.getElementById('ffForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn  = document.getElementById('ffSaveBtn');
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
        btn.disabled  = true;
        document.getElementById('ffModalError').classList.add('d-none');
        document.getElementById('ffModalSuccess').classList.add('d-none');

        try {
            const res  = await fetch('?handler=SaveFlatFile', { method: 'POST', body: new FormData(this) });
            const data = await res.json();
            if (data.success) {
                document.getElementById('ffModalSuccessText').textContent = data.message;
                document.getElementById('ffModalSuccess').classList.remove('d-none');
                setTimeout(() => window.location.reload(), 900);
            } else {
                document.getElementById('ffModalErrorText').textContent = data.error ?? 'Save failed.';
                document.getElementById('ffModalError').classList.remove('d-none');
            }
        } catch {
            document.getElementById('ffModalErrorText').textContent = 'Network error — please try again.';
            document.getElementById('ffModalError').classList.remove('d-none');
        } finally {
            btn.innerHTML = orig;
            btn.disabled  = false;
        }
    });

    // Auto-detect format and auto-fill label from the chosen file
    document.getElementById('ffFile').addEventListener('change', function () {
        const file = this.files?.[0];
        if (!file) return;

        const ext = file.name.split('.').pop().toLowerCase();
        const FMT = { csv: '0', tsv: '1', xlsx: '2', xls: '2', json: '3', xml: '4', yaml: '5', yml: '5' };
        if (FMT[ext] !== undefined) {
            document.getElementById('ffFormat').value = FMT[ext];
            onFfFormatChange();
        }

        // Auto-fill label from filename (strip extension) if the label is still empty
        const labelEl = document.getElementById('ffLabel');
        if (!labelEl.value.trim()) {
            labelEl.value = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
        }
    });

    // init format-dependent field visibility on page load
    onFfFormatChange();

    // ── Agent modal ───────────────────────────────────────────────────────────
    (function () {

        function clearAgentModal() {
            document.getElementById('agentId').value           = '';
            document.getElementById('agentName').value         = '';
            document.getElementById('agentIcon').value         = '🤖';
            document.getElementById('agentDescription').value  = '';
            document.getElementById('agentSystemPrompt').value = '';
            document.getElementById('agentModelId').value      = '';
            document.getElementById('agentSortOrder').value    = '0';
            document.getElementById('agentIsOrchestrator').checked = false;
            document.getElementById('agentIsEnabled').checked      = true;
            document.querySelectorAll('.agent-plugin-chk, .agent-skill-chk, .agent-mcp-chk, .agent-db-chk, .agent-ff-chk, .agent-rag-chk')
                .forEach(c => c.checked = false);
            document.getElementById('agentModalError').classList.add('d-none');
        }

        window.openAddAgentModal = function () {
            clearAgentModal();
            document.getElementById('agentModalLabel').textContent = 'Add Agent';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('agentModal')).show();
            setTimeout(() => document.getElementById('agentName').focus(), 300);
        };

        window.openEditAgentModal = function (btn) {
            clearAgentModal();
            // System.Text.Json serialises C# PascalCase property names as-is
            const agent = JSON.parse(btn.dataset.agent);
            document.getElementById('agentModalLabel').textContent = `Edit Agent — ${agent.Name}`;
            document.getElementById('agentId').value           = agent.Id ?? '';
            document.getElementById('agentName').value         = agent.Name ?? '';
            document.getElementById('agentIcon').value         = agent.Icon ?? '🤖';
            document.getElementById('agentDescription').value  = agent.Description ?? '';
            document.getElementById('agentSystemPrompt').value = agent.SystemPrompt ?? '';
            document.getElementById('agentModelId').value      = agent.ModelId ?? '';
            document.getElementById('agentSortOrder').value    = agent.SortOrder ?? 0;
            document.getElementById('agentIsOrchestrator').checked = !!agent.IsOrchestrator;
            document.getElementById('agentIsEnabled').checked      = agent.IsEnabled !== false;

            const setChecked = (selector, idList) => {
                const ids = new Set(idList ?? []);
                document.querySelectorAll(selector).forEach(c => { c.checked = ids.has(c.value); });
            };
            setChecked('.agent-plugin-chk', agent.AllowedPluginKeys);
            setChecked('.agent-skill-chk',  agent.AllowedSkillIds);
            setChecked('.agent-mcp-chk',    agent.AllowedMcpServerIds);
            setChecked('.agent-db-chk',     agent.AllowedDatabaseKeys);
            setChecked('.agent-ff-chk',     agent.AllowedFlatFileIds);
            setChecked('.agent-rag-chk',    agent.AllowedRagDocumentIds);

            bootstrap.Modal.getOrCreateInstance(document.getElementById('agentModal')).show();
        };

        window.confirmDeleteAgent = function (id, name) {
            if (!confirm(`Delete agent "${name}"?\n\nThis cannot be undone.`)) return;
            document.getElementById('agentDeleteId').value = id;
            document.getElementById('agentDeleteForm').submit();
        };

        // AJAX save
        document.getElementById('agentForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn  = document.getElementById('agentSaveBtn');
            const orig = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saving…';
            btn.disabled  = true;
            document.getElementById('agentModalError').classList.add('d-none');

            try {
                const res  = await fetch('?handler=SaveAgent', { method: 'POST', body: new FormData(this) });
                const data = await res.json();
                if (data.success) {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('agentModal')).hide();
                    window.location.reload();
                } else {
                    document.getElementById('agentModalErrorText').textContent = data.error ?? 'Save failed.';
                    document.getElementById('agentModalError').classList.remove('d-none');
                }
            } catch {
                document.getElementById('agentModalErrorText').textContent = 'Network error — please try again.';
                document.getElementById('agentModalError').classList.remove('d-none');
            } finally {
                btn.innerHTML = orig;
                btn.disabled  = false;
            }
        });

    })();

    // ── Settings tabs ─────────────────────────────────────────────────────────
    (function () {
        const panes = document.querySelectorAll('.settings-tab-pane');
        const btns  = document.querySelectorAll('#settingsTabs [data-tab]');

        function activateTab(id) {
            btns.forEach(b  => b.classList.toggle('active', b.dataset.tab === id));
            panes.forEach(p => p.style.display = (p.id === 'tab-pane-' + id) ? 'block' : 'none');
            sessionStorage.setItem('settings-tab', id);
        }

        btns.forEach(b => b.addEventListener('click', () => activateTab(b.dataset.tab)));

        const saved = sessionStorage.getItem('settings-tab');
        const valid = saved && document.querySelector('[data-tab="' + saved + '"]');
        // Default to LLM if rendered (SuperAdmin), otherwise the first visible tab.
        const fallback = document.querySelector('[data-tab="llm"]')
            ? 'llm'
            : (btns[0]?.dataset.tab ?? 'mcp');
        activateTab(valid ? saved : fallback);
    })();

})();
</script>
}
