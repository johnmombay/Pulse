@* ═══════════════════════════════════════════════════════════════════════════
   FLAT FILE ADD / EDIT MODAL
═══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="ffModal" tabindex="-1" aria-labelledby="ffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ffModalLabel">Add Data Source</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="ffForm" method="post" asp-page-handler="SaveFlatFile" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div id="ffModalError"   class="alert alert-danger  py-2 px-3 mb-3 d-none"><span id="ffModalErrorText"></span></div>
                    <div id="ffModalSuccess" class="alert alert-success py-2 px-3 mb-3 d-none"><span id="ffModalSuccessText"></span></div>

                    <input type="hidden" name="FlatFile.Id" id="ffId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Label <span class="text-danger">*</span></label>
                            <input name="FlatFile.Label" id="ffLabel" class="form-control"
                                   placeholder="Monthly Sales Data" maxlength="200" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Format</label>
                            <select name="FlatFile.Format" id="ffFormat" class="form-select" onchange="onFfFormatChange()">
                                <option value="0">CSV (.csv)</option>
                                <option value="1">Tab-delimited (.tsv / .txt)</option>
                                <option value="2">Excel (.xlsx / .xls)</option>
                                <option value="3">JSON (.json)</option>
                                <option value="4">XML (.xml)</option>
                                <option value="5">YAML (.yaml / .yml)</option>
                                <option value="6">Fixed-width text</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            File <span class="text-danger" id="ffFileRequired">*</span>
                        </label>
                        <input type="file" name="FlatFileUpload" id="ffFile" class="form-control"
                               accept=".csv,.tsv,.txt,.xlsx,.xls,.json,.xml,.yaml,.yml" />
                        <div id="ffCurrentFile" class="mt-2 d-none d-flex align-items-center gap-2">
                            <span class="badge bg-secondary-subtle border border-secondary-subtle text-secondary-emphasis"
                                  style="font-size:.8rem;font-family:monospace" id="ffCurrentFileName"></span>
                            <span class="text-muted small">current file &mdash; leave blank to keep it</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4" id="ffDelimiterGroup">
                            <label class="form-label fw-semibold">Delimiter <span class="text-muted fw-normal small">(optional)</span></label>
                            <input name="FlatFile.Delimiter" id="ffDelimiter" class="form-control"
                                   maxlength="1" placeholder="auto (,)" style="font-family:monospace" />
                            <div class="form-text">Leave blank to use the format default (comma/tab).</div>
                        </div>
                        <div class="col-md-4" id="ffSheetGroup" style="display:none">
                            <label class="form-label fw-semibold">Sheet Name <span class="text-muted fw-normal small">(optional)</span></label>
                            <input name="FlatFile.SheetName" id="ffSheet" class="form-control"
                                   placeholder="Sheet1" />
                            <div class="form-text">Leave blank to use the first sheet.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Encoding</label>
                            <select name="FlatFile.Encoding" id="ffEncoding" class="form-select">
                                <option value="UTF-8">UTF-8 (default)</option>
                                <option value="windows-1252">Windows-1252 (Latin)</option>
                                <option value="iso-8859-1">ISO-8859-1</option>
                                <option value="UTF-16">UTF-16</option>
                                <option value="ASCII">ASCII</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Max Rows</label>
                            <input name="FlatFile.MaxRows" id="ffMaxRows" class="form-control"
                                   type="number" min="1" max="100000" value="1000" />
                        </div>
                    </div>

                    <div class="mb-3" id="ffHeadersGroup">
                        <div class="form-check form-switch">
                            <input name="FlatFile.HasHeaders" id="ffHeaders" class="form-check-input"
                                   type="checkbox" role="switch" checked />
                            <label class="form-check-label fw-semibold" for="ffHeaders">
                                First row contains column headers
                            </label>
                        </div>
                    </div>

                    <div class="mb-3" id="ffFixedWidthGroup" style="display:none">
                        <label class="form-label fw-semibold">Fixed-Width Column Definitions</label>
                        <textarea name="FlatFile.FixedWidthSpec" id="ffFixedWidthSpec" class="form-control"
                                  rows="5" style="font-family:monospace;font-size:.82rem"
                                  placeholder="One column per line in format  Name:Start:Length&#10;E.g.:&#10;FirstName:0:20&#10;LastName:20:20&#10;Age:40:3"></textarea>
                        <div class="form-text">Format: <code>ColumnName:StartPosition:Length</code> — positions are 0-based.</div>
                    </div>

                    <div class="form-check form-switch">
                        <input name="FlatFile.IsEnabled" id="ffEnabled" class="form-check-input"
                               type="checkbox" role="switch" checked />
                        <label class="form-check-label fw-semibold" for="ffEnabled">Enabled</label>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="ffSaveBtn" class="btn btn-primary">💾 Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

