@page
@model SettingsModel
@using Pulse.Models
@{
    ViewData["Title"] = "Settings";
    var llmSaveSuccess = TempData["SaveSuccess"]    is bool b  && b;
    var mcpSuccess     = TempData["McpSuccess"]     as string;
    var skillSuccess   = TempData["SkillSuccess"]   as string;
    var ragSuccess     = TempData["RagSuccess"]     as string;
    var memSuccess     = TempData["MemSuccess"]     as string;
    var dbConnSuccess2 = TempData["DbConnSuccess"]  as string;
    var terminalSuccessTop = TempData["TerminalSuccess"] as string;
    var agentMailSuccess   = TempData["AgentMailSuccess"] as string;
    var logoSuccess    = TempData["LogoSuccess"]    as string;
    var logoError      = TempData["LogoError"]      as string;
    var agentSuccess   = TempData["AgentSuccess"]   as string;
    var agentError     = TempData["AgentError"]     as string;
}
@section Styles {
<style>
    /* ── Settings tabs ─────────────────────────────────────────────────────── */
    .settings-tabs { border-bottom: 2px solid #dee2e6; flex-wrap: wrap; gap: 0; }
    .settings-tabs .nav-link {
        color: #6c757d; font-size: .82rem; font-weight: 500;
        padding: .48rem .9rem; border: 1px solid transparent;
        border-radius: .375rem .375rem 0 0; white-space: nowrap;
        cursor: pointer; background: none; transition: color .15s, background .15s;
    }
    .settings-tabs .nav-link:hover  { color: #212529; background: #f8f9fa; border-color: #e9ecef #e9ecef transparent; }
    .settings-tabs .nav-link.active { color: #0d6efd; background: #fff; border-color: #dee2e6 #dee2e6 #fff; font-weight: 600; }
    .settings-tab-pane { display: none; }
    /* ── Settings section header */
    .settings-section-header {
        display:flex; align-items:center; gap:.5rem;
        font-size:1rem; font-weight:600; color:#495057;
    }
    .key-row { display:flex; align-items:center; gap:.5rem; margin-bottom:.5rem; animation:rowIn .18s ease; }
    @@keyframes rowIn { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:translateY(0)} }
    .key-num { width:2rem; text-align:center; font-size:.78rem; color:#6c757d; font-weight:600; flex-shrink:0; }
    .key-row input { font-family:'Courier New',monospace; font-size:.88rem; letter-spacing:.04em; }
    .btn-icon { width:34px; height:34px; padding:0; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .model-chip {
        display:inline-block; cursor:pointer; font-size:.78rem;
        padding:.2rem .55rem; border-radius:99px; border:1px solid #dee2e6;
        background:#f8f9fa; color:#495057; transition:all .15s; user-select:none;
    }
    .model-chip:hover { background:#e9ecef; border-color:#0d6efd; color:#0d6efd; }
    .info-badge {
        font-size:.75rem; background:#e7f1ff; color:#084298;
        border:1px solid #b6d4fe; border-radius:.4rem;
        padding:.35rem .7rem; display:inline-flex; align-items:center; gap:.35rem;
    }
    .mcp-endpoint { max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .transport-badge { font-size:.7rem; text-transform:uppercase; letter-spacing:.05em; }
    /* ── Skill instruction drop zone ── */
    #skillDropOverlay {
        border-radius: .375rem;
        transition: opacity .15s;
        font-size: 1.05rem;
        font-weight: 500;
        color: #0d6efd;
        pointer-events: none;
        background: rgba(13,110,253,.07);
    }
    #skillInstructions.drag-over { border-color: #0d6efd; box-shadow: 0 0 0 .25rem rgba(13,110,253,.15); }
    .skill-file-badge {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .75rem; background: #d1e7dd; color: #0a3622;
        border: 1px solid #a3cfbb; border-radius: .35rem;
        padding: .2rem .5rem; max-width: 220px;
    }
    .skill-file-badge span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 160px; }
    .skill-char-count { font-size: .72rem; color: #6c757d; white-space: nowrap; }
    /* ── Memory ── */
    .mem-importance { color: #f59e0b; letter-spacing: .05em; white-space: nowrap; }
    .mem-src-auto   { font-size: .7rem; background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; border-radius:.3rem; padding:.1rem .4rem; }
    .mem-src-manual { font-size: .7rem; background:#dcfce7; color:#166534; border:1px solid #bbf7d0; border-radius:.3rem; padding:.1rem .4rem; }
    .mem-content-cell { max-width: 420px; white-space: pre-wrap; word-break: break-word; font-size: .875rem; }
</style>
}

<div class="d-flex align-items-center gap-2 mb-3">
    <h2 class="mb-0 fw-bold">⚙️ Settings</h2>
</div>

@* ── Alerts
@if (llmSaveSuccess)
{
    <div id="llmAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>LLM settings saved. Changes take effect on the next agent call.</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (mcpSuccess != null)
{
    <div id="mcpAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@mcpSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (skillSuccess != null)
{
    <div id="skillAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@skillSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (ragSuccess != null)
{
    <div id="ragAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@ragSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (memSuccess != null)
{
    <div id="memAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@memSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (logoSuccess != null)
{
    <div id="logoAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@logoSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (logoError != null)
{
    <div id="logoErrAlert" class="alert alert-danger alert-dismissible d-flex align-items-center gap-2 mb-4">
        ❌ <span>@logoError</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (agentSuccess != null)
{
    <div id="agentSuccessAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@agentSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (agentError != null)
{
    <div id="agentErrorAlert" class="alert alert-danger alert-dismissible d-flex align-items-center gap-2 mb-4">
        ❌ <span>@agentError</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@{
    var appNameSuccess = TempData["AppNameSuccess"] as string;
}
@if (appNameSuccess != null)
{
    <div id="appNameAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@appNameSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Appearance ──────────────────────────────────────────────────────────── *@
<div class="card shadow-sm rounded-3 mb-3">
    <div class="card-body py-3 px-4">

        @* Dark mode row *@
        <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <span style="font-size:1.15rem">🎨</span>
                <div>
                    <div class="fw-semibold" style="font-size:.9rem">Appearance</div>
                    <div class="text-muted" id="themeDesc" style="font-size:.78rem">Light mode is active.</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span title="Light mode" style="font-size:1.05rem;line-height:1">☀️</span>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="darkModeToggle"
                           style="width:2.6rem;height:1.3rem;cursor:pointer" aria-label="Toggle dark mode">
                </div>
                <span title="Dark mode" style="font-size:1.05rem;line-height:1">🌙</span>
            </div>
        </div>

        <hr class="my-3" />

        @* App name row *@
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <span style="font-size:1.15rem">🏷️</span>
                <div>
                    <div class="fw-semibold" style="font-size:.9rem">App Name</div>
                    <div class="text-muted" style="font-size:.78rem">Browser title &middot; sidebar &middot; auth pages &middot; emails</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <form method="post" asp-page-handler="SaveAppName" class="d-inline-flex align-items-center gap-2">
                    @Html.AntiForgeryToken()
                    <input asp-for="AppName" class="form-control form-control-sm" style="max-width:240px"
                           placeholder="Pulse" maxlength="60" spellcheck="false" />
                    <button type="submit" class="btn btn-sm btn-primary">💾 Save</button>
                </form>
            </div>
        </div>

        <hr class="my-3" />

        @* Logo upload row *@
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <span style="font-size:1.15rem">🖼️</span>
                <div>
                    <div class="fw-semibold" style="font-size:.9rem">Sidebar Logo</div>
                    <div class="text-muted" style="font-size:.78rem">PNG · exactly 200 × 50 px · max 256 KB</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 ms-auto flex-wrap">
                @if (!string.IsNullOrEmpty(Model.CurrentLogoFileName))
                {
                    <img src="@Model.CurrentLogoUrl?v=@Model.CurrentLogoVersion"
                         alt="Current logo"
                         style="height:24px;width:auto;max-width:120px;object-fit:contain;border:1px solid #dee2e6;border-radius:.25rem;padding:2px 6px;background:#fff" />
                    <form method="post" asp-page-handler="DeleteLogo" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Remove the custom logo and restore the default?')">
                            🗑 Remove
                        </button>
                    </form>
                }
                <form method="post" asp-page-handler="UploadLogo" enctype="multipart/form-data"
                      class="d-inline-flex align-items-center gap-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="LogoUpload" id="logoFileInput" accept=".png,image/png"
                           class="form-control form-control-sm" style="max-width:210px" />
                    <button type="submit" class="btn btn-sm btn-primary">⬆ Upload</button>
                </form>
            </div>
        </div>

    </div>
</div>

@* ── Tab navigation ──────────────────────────────────────────────────────── *@
@{
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}
<ul class="nav settings-tabs mb-0" id="settingsTabs" role="tablist">
    @if (isSuperAdmin)
    {
        <li class="nav-item"><button type="button" class="nav-link" data-tab="llm"     >🤖 LLM</button></li>
    }
    <li class="nav-item"><button type="button" class="nav-link" data-tab="mcp"     >🔌 MCP</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tab="data"    >🗄️ Data</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tab="skills"  >⚡ Skills</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tab="agents"  >🤖 Agents</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tab="rag"     >🗂️ RAG</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-tab="memory"  >🧠 Memory</button></li>
    @if (isSuperAdmin)
    {
        <li class="nav-item"><button type="button" class="nav-link" data-tab="terminal">🖥️ Terminal</button></li>
    }
    @if (isSuperAdmin)
    {
        <li class="nav-item"><button type="button" class="nav-link" data-tab="agentmail">✉️ AgentMail</button></li>
        <li class="nav-item"><button type="button" class="nav-link" data-tab="security">🔒 Security</button></li>
    }
</ul>

@* ═══════════════════════════════════════════════════════════════════════════
   LLM CONFIGURATION (SuperAdmin only — global model + API keys)
═══════════════════════════════════════════════════════════════════════════ *@
@if (isSuperAdmin)
{
<div id="tab-pane-llm" class="settings-tab-pane pt-4">
<form method="post" id="llmForm" novalidate>
    @Html.AntiForgeryToken()
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <div class="settings-section-header">🤖 LLM Configuration</div>
        </div>
        <div class="card-body">

            <div class="mb-4">
                <label asp-for="Input.ModelId" class="form-label fw-semibold">Model ID</label>
                <input asp-for="Input.ModelId" class="form-control"
                       placeholder="e.g. gemini-2.0-flash" autocomplete="off" spellcheck="false" />
                <span asp-validation-for="Input.ModelId" class="text-danger small"></span>
                <div class="form-text">
                    Enter any Gemini model ID supported by your API key
                    (e.g. <code>gemini-2.0-flash</code>, <code>gemini-2.5-flash</code>, <code>gemini-2.5-pro</code>).
                    This value is sent to Google as-is.
                    <br />
                    <strong>Global setting:</strong> applies to every tenant.
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ApiVersion" class="form-label fw-semibold">Gemini API Version</label>
                <select asp-for="Input.ApiVersion" class="form-select">
                    <option value="V1Beta">v1beta (default — most models, including previews)</option>
                    <option value="V1">v1 (stable GA endpoint)</option>
                </select>
                <div class="form-text">
                    Switch to <code>v1</code> only if Google explicitly states the model lives there.
                    Most preview / 3.x models are still served on <code>v1beta</code>.
                </div>
            </div>

            <hr class="my-3" />

            <div class="mb-2">
                <label class="form-label fw-semibold mb-0">API Keys</label>
                <div class="text-muted small mt-1 mb-3">
                    Keys rotate in round-robin after every call. A 5-second rate-limit gap is enforced automatically.<br />
                    <span class="info-badge mt-2">
                        ℹ️ Stored in <code>llm-settings.json</code>. Use User Secrets or Azure Key Vault for production.
                    </span>
                </div>
                <div id="keysContainer">
                    @for (int i = 0; i < Model.Input.ApiKeys.Count; i++)
                    {
                        <div class="key-row" data-index="@i">
                            <span class="key-num">#@(i + 1)</span>
                            <input type="password" name="Input.ApiKeys[@i]" value="@Model.Input.ApiKeys[i]"
                                   class="form-control" placeholder="AIza…" spellcheck="false" autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary btn-icon btn-toggle-vis" title="Show/hide">👁</button>
                            <button type="button" class="btn btn-outline-danger btn-icon btn-remove-key" title="Remove">✕</button>
                        </div>
                    }
                </div>
                <button type="button" id="addKeyBtn" class="btn btn-outline-primary btn-sm mt-2">➕ Add Key</button>
            </div>
        </div>
        <div class="card-footer bg-white border-top d-flex justify-content-end py-3">
            <button type="submit" class="btn btn-primary px-4" id="llmSaveBtn">
                <span id="llmSaveTxt">💾 Save LLM Settings</span>
                <span id="llmSaveSpinner" class="spinner-border spinner-border-sm ms-1 d-none"></span>
            </button>
        </div>
    </div>
</form>
</div><!-- /tab-pane-llm -->
}

<div id="tab-pane-mcp" class="settings-tab-pane pt-4">
@* ═══════════════════════════════════════════════════════════════════════════
   MCP SERVERS
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="settings-section-header">🔌 MCP Servers</div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openAddMcpModal()">
            ➕ Add Server
        </button>
    </div>

    @if (Model.McpServers.Count == 0)
    {
        <div class="card-body text-center py-5 text-muted">
            <div style="font-size:2.5rem">🔌</div>
            <p class="mt-2 mb-1">No MCP servers configured yet.</p>
            <p class="small">Add a server to give the AI agent access to external tools (filesystem, GitHub, databases, custom APIs…)</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="openAddMcpModal()">
                ➕ Add your first MCP server
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Name</th>
                        <th>Transport</th>
                        <th>Endpoint / Command</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var srv in Model.McpServers)
                    {
                        var endpoint = srv.TransportType == "stdio"
                            ? $"{srv.Command} {srv.Arguments}".Trim()
                            : srv.Url ?? "";
                        <tr>
                            <td class="ps-3 fw-semibold">@srv.Name</td>
                            <td>
                                <span class="badge @(srv.TransportType == "stdio" ? "bg-warning text-dark" : "bg-info text-dark") transport-badge">
                                    @srv.TransportType
                                </span>
                            </td>
                            <td>
                                <span class="mcp-endpoint text-muted small d-inline-block" title="@endpoint">
                                    @endpoint
                                </span>
                            </td>
                            <td>
                                @if (srv.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            onclick="openEditMcpModal('@srv.Id','@Html.Raw(srv.Name.Replace("'","\\\'"))','@srv.TransportType','@(srv.Url ?? "")','@(srv.Command ?? "")','@(srv.Arguments ?? "")','@srv.IsEnabled')">
                                        ✏️
                                    </button>
                                    <form method="post" asp-page-handler="ToggleMcp" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@srv.Id" />
                                        <button type="submit"
                                                class="btn @(srv.IsEnabled ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(srv.IsEnabled ? "Disable" : "Enable")">
                                            @(srv.IsEnabled ? "⏸" : "▶")
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger"
                                            onclick="confirmDeleteMcp('@srv.Id','@Html.Raw(srv.Name.Replace("'","\\\'"))')">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2 px-3">
            @Model.McpServers.Count server(s) — @Model.McpServers.Count(s => s.IsEnabled) enabled
        </div>
    }
</div>

@* ── Hidden delete form ────────────────────────────────────────────────────── *@
<form id="mcpDeleteForm" method="post" asp-page-handler="DeleteMcp">
    @Html.AntiForgeryToken()
    <input type="hidden" id="mcpDeleteId" name="id" value="" />
</form>

@* ═══════════════════════════════════════════════════════════════════════════
   ADD / EDIT MODAL
═══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="mcpModal" tabindex="-1" aria-labelledby="mcpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mcpModalLabel">Add MCP Server</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SaveMcp" id="mcpForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <!-- Inline error banner (populated by JS on fetch failure) -->
                    <div id="mcpModalError" class="alert alert-danger alert-dismissible py-2 px-3 mb-3 d-none" role="alert">
                        <span id="mcpModalErrorText"></span>
                        <button type="button" class="btn-close btn-sm" onclick="document.getElementById('mcpModalError').classList.add('d-none')"></button>
                    </div>

                    <input type="hidden" asp-for="McpServer.Id" id="mcpId" />

                    <div class="mb-3">
                        <label asp-for="McpServer.Name" class="form-label fw-semibold">
                            Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="McpServer.Name" id="mcpName" class="form-control"
                               placeholder="e.g. Filesystem, GitHub, Brave Search" />
                        <span asp-validation-for="McpServer.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="McpServer.TransportType" class="form-label fw-semibold">Transport</label>
                        <select asp-for="McpServer.TransportType" id="mcpTransport" class="form-select"
                                onchange="updateTransportFields(this.value)">
                            <option value="http">HTTP / SSE (remote server)</option>
                            <option value="stdio">stdio (local process)</option>
                        </select>
                    </div>

                    <div id="httpFields">
                        <div class="mb-3">
                            <label asp-for="McpServer.Url" class="form-label fw-semibold">
                                Server URL <span class="text-danger">*</span>
                            </label>
                            <input asp-for="McpServer.Url" id="mcpUrl" class="form-control"
                                   placeholder="https://mcp.example.com/sse" spellcheck="false" />
                            <span asp-validation-for="McpServer.Url" class="text-danger small"></span>
                            <div class="form-text">Full URL of the SSE or Streamable HTTP endpoint.</div>
                        </div>
                    </div>

                    <div id="stdioFields" style="display:none">
                        <div class="mb-3">
                            <label asp-for="McpServer.Command" class="form-label fw-semibold">
                                Command <span class="text-danger">*</span>
                            </label>
                            <input asp-for="McpServer.Command" id="mcpCommand" class="form-control"
                                   placeholder="npx" spellcheck="false" style="font-family:monospace" />
                            <span asp-validation-for="McpServer.Command" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="McpServer.Arguments" class="form-label fw-semibold">Arguments</label>
                            <input asp-for="McpServer.Arguments" id="mcpArguments" class="form-control"
                                   placeholder="-y @@modelcontextprotocol/server-filesystem /tmp"
                                   spellcheck="false" style="font-family:monospace" />
                            <div class="form-text">Space-separated. Wrap paths with spaces in quotes is not yet supported.</div>
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input asp-for="McpServer.IsEnabled" id="mcpEnabled" class="form-check-input"
                               type="checkbox" role="switch" checked />
                        <label asp-for="McpServer.IsEnabled" class="form-check-label">Enabled</label>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">💾 Save Server</button>
                </div>
            </form>
        </div>
    </div>
</div>
</div><!-- /tab-pane-mcp -->

<div id="tab-pane-data" class="settings-tab-pane pt-4">
@* ═══════════════════════════════════════════════════════════════════════════
   DATABASE CONNECTIONS
═══════════════════════════════════════════════════════════════════════════ *@
@{
    var dbConnSuccess = TempData["DbConnSuccess"] as string;
}
@if (dbConnSuccess != null)
{
    <div id="dbConnAlert" class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-4">
        ✅ <span>@dbConnSuccess</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="settings-section-header">🗄️ Database Connections</div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openAddDbConnModal()">
            ➕ Add Connection
        </button>
    </div>

    @if (!Model.DatabaseConnections.Any())
    {
        <div class="card-body text-center py-5 text-muted">
            <div style="font-size:2.5rem">🗄️</div>
            <p class="mt-2 mb-1 fw-semibold">No database connections yet.</p>
            <p class="small">Add a connection to let the AI agent query SQL Server, Azure SQL, PostgreSQL, MySQL, MariaDB, or Oracle databases directly.</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="openAddDbConnModal()">
                ➕ Add your first connection
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Label</th>
                        <th>Provider</th>
                        <th>Read-only</th>
                        <th>Max Rows</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (id, entry) in Model.DatabaseConnections)
                    {
                        var providerBadge = entry.Provider switch {
                            DatabaseProvider.AzureSQL    => "bg-primary",
                            DatabaseProvider.PostgreSQL  => "bg-info text-dark",
                            DatabaseProvider.MySQL       => "bg-warning text-dark",
                            DatabaseProvider.MariaDB     => "bg-warning text-dark",
                            DatabaseProvider.Oracle      => "bg-danger",
                            _                            => "bg-secondary"
                        };
                        <tr>
                            <td class="ps-3">
                                <code class="small">@id</code>
                            </td>
                            <td class="fw-semibold">@entry.Label</td>
                            <td>
                                <span class="badge @providerBadge transport-badge">@entry.Provider</span>
                            </td>
                            <td>
                                @if (entry.ReadOnly)
                                {
                                    <span class="badge bg-success">🔒 Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">✏️ No</span>
                                }
                            </td>
                            <td class="text-muted small">@entry.MaxRows</td>
                            <td>
                                @if (entry.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            title="Test connection"
                                            onclick="testDbConn('@id', this)">
                                        🔌
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary"
                                            title="Edit"
                                            onclick="openEditDbConnModal('@id','@Html.Raw(entry.Label.Replace("'","\\'"))','@entry.Provider','@Html.Raw(entry.ConnectionString.Replace("'","\\'"))','@entry.IsEnabled','@entry.ReadOnly','@entry.MaxRows','@string.Join(",",entry.AllowedSchemas)')">
                                        ✏️
                                    </button>
                                    <form method="post" asp-page-handler="ToggleDbConn" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@id" />
                                        <button type="submit"
                                                class="btn @(entry.IsEnabled ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(entry.IsEnabled ? "Disable" : "Enable")">
                                            @(entry.IsEnabled ? "⏸" : "▶")
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger"
                                            title="Delete"
                                            onclick="confirmDeleteDbConn('@id')">
                                        🗑
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2 px-3">
            @Model.DatabaseConnections.Count connection(s) —
            @Model.DatabaseConnections.Count(c => c.Entry.IsEnabled) enabled
        </div>
    }
</div>

@* ── Hidden delete form ────────────────────────────────────────────────────── *@
<form id="dbConnDeleteForm" method="post" asp-page-handler="DeleteDbConn">
    @Html.AntiForgeryToken()
    <input type="hidden" id="dbConnDeleteId" name="id" value="" />
</form>

@* ═══════════════════════════════════════════════════════════════════════════
   DATABASE CONNECTION ADD / EDIT MODAL
═══════════════════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="dbConnModal" tabindex="-1" aria-labelledby="dbConnModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dbConnModalLabel">Add Database Connection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="SaveDbConn" id="dbConnForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div id="dbConnModalError" class="alert alert-danger alert-dismissible py-2 px-3 mb-3 d-none" role="alert">
                        <span id="dbConnModalErrorText"></span>
                        <button type="button" class="btn-close btn-sm"
                                onclick="document.getElementById('dbConnModalError').classList.add('d-none')"></button>
                    </div>
                    <div id="dbConnModalSuccess" class="alert alert-success py-2 px-3 mb-3 d-none">
                        <span id="dbConnModalSuccessText"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label asp-for="DbConn.ConnectionId" class="form-label fw-semibold">
                                Connection ID <span class="text-danger">*</span>
                            </label>
                            <input asp-for="DbConn.ConnectionId" id="dbConnId" class="form-control"
                                   placeholder="sales-db" spellcheck="false" autocomplete="off"
                                   oninput="this.value=this.value.toLowerCase().replace(/\s+/g,'-')" />
                            <div class="form-text">Lowercase slug used by the agent, e.g. <code>sales-db</code>.</div>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="DbConn.Label" class="form-label fw-semibold">Label</label>
                            <input asp-for="DbConn.Label" id="dbConnLabel" class="form-control"
                                   placeholder="Production Sales Database" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DbConn.Provider" class="form-label fw-semibold">Provider</label>
                        <select asp-for="DbConn.Provider" id="dbConnProvider" class="form-select"
                                onchange="updateDbConnProviderHint()">
                            <option value="SqlServer">SQL Server (on-premises)</option>
                            <option value="AzureSQL">Azure SQL (SQL / Azure AD / Managed Identity)</option>
                            <option value="PostgreSQL">PostgreSQL · AWS RDS PG · Aurora PG · Azure DB for PG</option>
                            <option value="MySQL">MySQL · AWS RDS MySQL · Aurora MySQL · Azure DB for MySQL</option>
                            <option value="MariaDB">MariaDB</option>
                            <option value="Oracle">Oracle (on-premises / OCI cloud)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DbConn.ConnectionString" class="form-label fw-semibold">
                            Connection String <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input asp-for="DbConn.ConnectionString" id="dbConnStr" class="form-control"
                                   type="password" spellcheck="false" autocomplete="off"
                                   placeholder="Server=…;Database=…;User Id=…;Password=…;" style="font-family:monospace;font-size:.85rem" />
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="toggleDbConnStrVis(this)" title="Show / hide">👁</button>
                        </div>
                        <div id="dbConnProviderHint" class="form-text text-muted mt-1"></div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="DbConn.MaxRows" class="form-label fw-semibold">Max Rows</label>
                            <input asp-for="DbConn.MaxRows" id="dbConnMaxRows" class="form-control"
                                   type="number" min="1" max="10000" value="500" />
                            <div class="form-text">Row cap on <code>db_execute_query</code> results.</div>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="DbConn.AllowedSchemas" class="form-label fw-semibold">
                                Allowed Schemas
                                <span class="text-muted fw-normal small">(optional)</span>
                            </label>
                            <input asp-for="DbConn.AllowedSchemas" id="dbConnSchemas" class="form-control"
                                   placeholder="public, reporting, dbo" />
                            <div class="form-text">Comma-separated. Leave blank to allow all schemas.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-4">
                        <div class="form-check form-switch">
                            <input asp-for="DbConn.ReadOnly" id="dbConnReadOnly" class="form-check-input"
                                   type="checkbox" role="switch" checked />
                            <label asp-for="DbConn.ReadOnly" class="form-check-label fw-semibold">
                                Read-only
                                <span class="text-muted fw-normal small">(SELECT only)</span>
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="DbConn.IsEnabled" id="dbConnEnabled" class="form-check-input"
                                   type="checkbox" role="switch" checked />
                            <label asp-for="DbConn.IsEnabled" class="form-check-label">Enabled</label>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary me-auto"
                            id="dbConnTestBtn" onclick="testDbConnFromModal()">
                        🔌 Test Connection
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="dbConnSaveBtn">💾 Save Connection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════════════
   OTHER DATA SOURCES (Flat Files)
═══════════════════════════════════════════════════════════════════════════ *@
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
        <div class="settings-section-header">📂 Other Data Sources</div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openAddFlatFileModal()">
            ➕ Add Data Source
        </button>
    </div>

    @if (!Model.FlatFileSources.Any())
    {
        <div class="card-body text-center py-5 text-muted">
            <div style="font-size:2.5rem">📂</div>
            <p class="mt-2 mb-1">No flat-file data sources yet.</p>
            <p class="small">Connect CSV, Excel, JSON, XML, YAML, or fixed-width files so the agent can read and analyse them directly.</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="openAddFlatFileModal()">
                ➕ Add your first data source
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Label</th>
                        <th>Format</th>
                        <th>File</th>
                        <th>Max Rows</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var src in Model.FlatFileSources)
                    {
                        var fmtBadge = src.Format switch {
                            FlatFileFormat.Csv          => "bg-success",
                            FlatFileFormat.TabDelimited => "bg-success",
                            FlatFileFormat.Excel        => "bg-primary",
                            FlatFileFormat.Json         => "bg-warning text-dark",
                            FlatFileFormat.Xml          => "bg-info text-dark",
                            FlatFileFormat.Yaml         => "bg-secondary",
                            FlatFileFormat.FixedWidth   => "bg-dark",
                            _                           => "bg-secondary"
                        };
                        var fmtLabel = src.Format switch {
                            FlatFileFormat.Csv          => "CSV",
                            FlatFileFormat.TabDelimited => "Tab",
                            FlatFileFormat.Excel        => "Excel",
                            FlatFileFormat.Json         => "JSON",
                            FlatFileFormat.Xml          => "XML",
                            FlatFileFormat.Yaml         => "YAML",
                            FlatFileFormat.FixedWidth   => "Fixed-W",
                            _                           => src.Format.ToString()
                        };
                        <tr>
                            <td class="ps-3"><code class="small">@src.Id</code></td>
                            <td class="fw-semibold">@src.Label</td>
                            <td><span class="badge @fmtBadge transport-badge">@fmtLabel</span></td>
                            <td class="text-muted small" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                title="@src.FilePath">@System.IO.Path.GetFileName(src.FilePath)</td>
                            <td class="text-muted small">@src.MaxRows</td>
                            <td>
                                @if (src.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary"
                                            title="Preview first 10 rows"
                                            onclick="previewFlatFile('@src.Id', this)">👁</button>
                                    <button type="button" class="btn btn-outline-secondary"
                                            title="Edit"
                                            onclick="openEditFlatFileModal('@src.Id')">✏️</button>
                                    <form method="post" asp-page-handler="ToggleFlatFile" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@src.Id" />
                                        <button type="submit"
                                                class="btn @(src.IsEnabled ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(src.IsEnabled ? "Disable" : "Enable")">
                                            @(src.IsEnabled ? "⏸" : "▶")
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger"
                                            title="Delete"
                                            onclick="confirmDeleteFlatFile('@src.Id','@Html.Raw(src.Label.Replace("'","\\\'"))')">🗑</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white text-muted small py-2 px-3">
            @Model.FlatFileSources.Count source(s) — @Model.FlatFileSources.Count(s => s.IsEnabled) enabled
        </div>
    }
</div>

@* ── Hidden delete form ──────────────────────────────────────────────────── *@
<form id="ffDeleteForm" method="post" asp-page-handler="DeleteFlatFile">
    @Html.AntiForgeryToken()
    <input type="hidden" id="ffDeleteId" name="id" value="" />
</form>

@* ── Preview modal ──────────────────────────────────────────────────────── *@
