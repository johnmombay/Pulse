@page
@model Pulse.Pages.LessonsModel
@{
    ViewData["Title"] = "Agent Lessons";
    string ScoreColor(double s) => s >= 0.8 ? "success" : s >= 0.5 ? "warning" : "danger";
}

<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        Agent Lessons
    </h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#testModal">
            ＋ Test Reflection
        </button>
        <form method="post" asp-page-handler="Clear"
              onsubmit="return confirm('Clear ALL lessons for this tenant?')">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-danger">🗑 Clear All</button>
        </form>
    </div>
</div>

@if (Model.TestResultMessage is not null)
{
    var cls = Model.TestResultMessage.StartsWith("✓") ? "success" : "danger";
    <div class="alert alert-@cls alert-dismissible fade show" role="alert">
        @Model.TestResultMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Stats cards *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold">@Model.Stats.Total</div>
                <div class="text-muted small">Total Lessons</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-success">@Model.Stats.SuccessCount</div>
                <div class="text-muted small">High Score (≥70%)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-danger">@Model.Stats.FailureCount</div>
                <div class="text-muted small">Low Score (&lt;70%)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-info">@(Model.Stats.AvgScore.ToString("P0"))</div>
                <div class="text-muted small">Avg Score</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold">@Model.Stats.DomainsLearned</div>
                <div class="text-muted small">Domains</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-primary">@Model.Stats.TopDomain</div>
                <div class="text-muted small">Top Domain</div>
            </div>
        </div>
    </div>
</div>

@* Filters *@
<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small mb-1">Domain</label>
        <select name="DomainFilter" class="form-select form-select-sm" style="min-width:130px">
            <option value="">All Domains</option>
            @foreach (var d in Model.Domains)
            {
                <option value="@d" selected="@(Model.DomainFilter == d)">@d</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">Agent</label>
        <select name="AgentFilter" class="form-select form-select-sm" style="min-width:150px">
            <option value="">All Agents</option>
            <option value="global" selected="@(Model.AgentFilter == "global")">Global (Orchestrator)</option>
            @foreach (var a in Model.AgentDefinitions)
            {
                <option value="@a.Id" selected="@(Model.AgentFilter == a.Id)">@a.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">Outcome</label>
        <select name="OutcomeFilter" class="form-select form-select-sm">
            <option value="">All</option>
            <option value="success" selected="@(Model.OutcomeFilter == "success")">High Score</option>
            <option value="failure" selected="@(Model.OutcomeFilter == "failure")">Low Score</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-secondary">Filter</button>
        <a asp-page="/Lessons" class="btn btn-sm btn-link">Reset</a>
    </div>
</form>

@* Table *@
@if (!Model.Lessons.Any())
{
    <div class="alert alert-secondary">
        No lessons yet. Lessons are learned automatically after agent executions, or you can trigger
        one manually with <strong>Test Reflection</strong>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:90px">Score</th>
                    <th style="width:90px">Domain</th>
                    <th style="width:120px">Agent</th>
                    <th>Goal</th>
                    <th>Lesson</th>
                    <th style="width:70px">Uses</th>
                    <th style="width:100px">Updated</th>
                    <th style="width:50px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lessons)
                {
                    var pct  = (int)(l.Score * 100);
                    var col  = ScoreColor(l.Score);
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <div class="progress flex-grow-1" style="height:6px">
                                    <div class="progress-bar bg-@col" style="width:@pct%"></div>
                                </div>
                                <small class="text-muted">@pct%</small>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary">@l.Domain</span></td>
                        <td class="text-truncate" style="max-width:120px" title="@l.AgentDefinitionId">
                            @(l.AgentDefinitionId ?? "Global")
                        </td>
                        <td class="text-truncate" style="max-width:200px" title="@l.GoalText">
                            @l.GoalText
                        </td>
                        <td style="max-width:300px">
                            <span title="@l.LessonText">
                                @(l.LessonText.Length > 120
                                    ? l.LessonText[..120] + "…"
                                    : l.LessonText)
                            </span>
                        </td>
                        <td class="text-center">@l.ReinforcementCount</td>
                        <td class="text-muted small">@l.UpdatedAt.ToString("MM/dd HH:mm")</td>
                        <td>
                            <form method="post" asp-page-handler="Delete"
                                  onsubmit="return confirm('Delete this lesson?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@l.Id" />
                                <button class="btn btn-link btn-sm text-danger p-0" title="Delete">✕</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Showing @Model.Lessons.Count lessons (max 200). Use filters to narrow down.</p>
}

@* Test Reflection Modal *@
<div class="modal fade" id="testModal" tabindex="-1" aria-labelledby="testModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="TestReflect">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="testModalLabel">Test Reflection</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Manually trigger the reflection loop to verify the agent can learn from
                        a given goal/outcome and that the lesson is persisted.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Domain</label>
                            <select asp-for="TestDomain" class="form-select">
                                @foreach (var d in Model.Domains)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Execution succeeded?</label>
                            <select asp-for="TestSucceeded" class="form-select">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Goal / Instruction</label>
                            <input asp-for="TestGoal" class="form-control"
                                   placeholder="e.g. Summarise today's news" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Action taken (optional)</label>
                            <textarea asp-for="TestAction" class="form-control" rows="2"
                                      placeholder="What the agent actually did…"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Outcome</label>
                            <textarea asp-for="TestOutcome" class="form-control" rows="3"
                                      placeholder="Agent's response or error message…"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Run Reflection</button>
                </div>
            </form>
        </div>
    </div>
</div>
